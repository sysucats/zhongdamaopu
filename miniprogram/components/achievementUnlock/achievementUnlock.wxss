@import "/pages/public/wxss/button.wxss";

:host {
  display: block;
  height: 0;
}

.unlock-card {
  /* 宽度、留白与滚动由弹窗统一给出；左右滑动切换挂在正文上 */
  position: relative;
  z-index: 1;
  text-align: center;
}

.unlock-head {
  text-align: center;
}

.unlock-subtitle {
  margin-top: 12rpx;
  color: var(--color-gray-max);
  font-size: 25rpx;
}

.unlock-continue {
  width: 50%;
  margin: 0 auto;
}

.unlock-swiper {
  overflow: hidden;
  /* 轮播撑满弹窗宽度，左右滑动不被正文内边距截断 */
  width: calc(100% + 2 * var(--space-lg));
  margin-left: calc(-1 * var(--space-lg));
  /* 高度贴合内容：徽章 + 名称 + 一行说明；说明较长时加高一行 */
  height: 510rpx;
  margin-top: 12rpx;
}

.unlock-swiper.tall {
  height: 548rpx;
}

.unlock-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 0;
}

.unlock-art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  height: 360rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-achievement-glow-inner) 0%, var(--color-achievement-glow-outer) 48%, transparent 72%);
}

.unlock-name {
  margin-top: 16rpx;
  color: var(--color-black-light);
  font-size: 34rpx;
  font-weight: 600;
}

.unlock-name.material-gold {
  color: var(--color-achievement-gold);
}

.unlock-name.material-silver {
  color: var(--color-achievement-silver);
}

.unlock-name.material-bronze {
  color: var(--color-achievement-bronze);
}

.unlock-description {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  margin-top: 12rpx;
  color: var(--color-gray-max);
  font-size: 25rpx;
  line-height: 1.5;
}

.unlock-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
}

.unlock-page-target {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44rpx;
  height: 44rpx;
}

.unlock-page-mark {
  width: 10rpx;
  height: 10rpx;
  border-radius: 10rpx;
  background: var(--color-gray-max);
  opacity: 0.3;
  transition:
    width 200ms ease,
    opacity 200ms ease;
}

.unlock-page-mark.active {
  width: 32rpx;
  opacity: 0.8;
}

.unlock-confetti {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  overflow: hidden;
  pointer-events: none;
}

.confetti-piece {
  position: absolute;
  top: 72%;
  opacity: 0;
  animation-name: confetti-launch;
  animation-fill-mode: both;
  animation-timing-function: linear;
  will-change: transform, opacity;
}

@keyframes confetti-launch {
  0% {
    opacity: 0;
    transform: translate3d(0, 0, 0) rotate(0);
    animation-timing-function: ease-out;
  }
  8% {
    opacity: 1;
  }
  45% {
    opacity: 1;
    transform: translate3d(var(--dx), var(--peak), 0) rotate(var(--spin));
    animation-timing-function: ease-in;
  }
  100% {
    opacity: 0;
    transform: translate3d(var(--end-x), 40vh, 0) rotate(var(--spin-end));
  }
}
