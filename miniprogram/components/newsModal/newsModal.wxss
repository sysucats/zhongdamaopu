@import "/pages/public/wxss/tag.wxss";
/* components/newsModal/newsModal.wxss */
.wx-modal-catlogo {
    position: absolute;
    top: -100rpx;
    right: 10rpx;
    height: 110rpx;
    margin-left: 95rpx;
}

.wx-modal {
  width: 600rpx;
  background-color: var(--color-surface);
  border-radius: var(--radius-modal);
  overflow: visible;
  padding: 0 35rpx;
}

.wx-modal-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.wx-modal-content {
  /* padding: 15px 15px 5px;
    min-height: 40px;
    line-height: 1.3;
    */
  white-space: pre-wrap;
  font-size: 28rpx;
  font-weight: 400;
  margin-bottom: 30rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  color: var(--color-gray-max);
}

/* 无图片时不限制内容显示行数 */
.wx-modal-content.full-height {
  -webkit-line-clamp: unset;
  margin-bottom: 0;
}

.wx-modal-image {
  margin: 10rpx;
  width: 540rpx;
}

.wx-modal-scroll {
  width: auto;
  padding: 15rpx 5rpx;
  height: 600rpx;
  background-color: var(--color-surface);
}

/* 无图片时减少滚动区域高度，使布局更紧凑 */
.wx-modal-scroll.no-image {
  height: auto;
  max-height: 450rpx;
}

.wx-modal-class {
  margin: 0 12rpx 0 0;
}

.wx-modal-user {
  font-size: 26rpx;
  color: var(--color-gray-dark);
  margin-right: 20rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.wx-modal-time {
  font-size: 26rpx;
  color: var(--color-gray-dark);
  flex-grow: 1;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.wx-modal-footer {
  display: flex;
  align-items: center;
  position: relative;
  line-height: 90rpx;
  font-size: 32rpx;
}

.wx-modal-footer::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1px;
  border-top: 1px solid var(--color-divider);
  color: var(--color-divider);
  -webkit-transform-origin: 0 0;
  transform-origin: 0 0;
  -webkit-transform: scaleY(0.5);
  transform: scaleY(0.5);
}

.wx-modal-btn {
  display: block;
  flex: 1;
  position: relative;
  text-align: center;
}

.wx-modal-footer .wx-modal-btn:nth-of-type(1) {
  color: var(--color-gray-max);
}

.wx-modal-footer .wx-modal-btn:nth-of-type(2) {
  color: var(--color-primary-text);
}

.wx-modal-footer .wx-modal-btn:nth-of-type(2):after {
  content: " ";
  position: absolute;
  left: 0;
  top: 0;
  width: 1px;
  bottom: 0;
  border-left: 1px solid var(--color-divider);
  color: var(--color-divider);
  transform-origin: 0 0;
  transform: scaleX(0.5);
}

/* 关联猫猫标识 */
.wx-modal-cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  align-self: flex-start;
  max-width: 100%;
  padding: 4rpx 16rpx 4rpx 4rpx;
  margin-bottom: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-bg);
}

.wx-modal-cat-chip-hover {
  opacity: 0.75;
}

.wx-modal-cat-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-gray-normal);
  flex-shrink: 0;
}

.wx-modal-cat-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
  background: var(--color-primary);
}

.wx-modal-cat-name {
  font-size: 22rpx;
  color: var(--color-primary-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
