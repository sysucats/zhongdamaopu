#search .popup-container {
  width: 100%;
  max-height: 80vh;
  background-color: var(--color-surface);
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.search-results {
  flex: 1;
  max-height: 600rpx;
}

.search-cat-item {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid var(--color-gray-light);
}

.search-cat-item.disabled {
  opacity: 0.6;
}

.search-cat-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: var(--color-gray-light);
}

.search-cat-info {
  margin-left: 15rpx;
  flex: 1;
}

.search-cat-name {
  font-size: 28rpx;
  color: var(--color-black-min);
}

.search-cat-location {
  font-size: 22rpx;
  color: var(--color-gray-dark);
}

.search-cat-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-gray-light);
  color: var(--color-black-min);
  font-size: var(--font-size-tag);
}

.item-hover {
  background-color: var(--color-bg-page);
}

.search-empty {
  text-align: center;
  padding: 40rpx 0;
  color: var(--color-gray-dark);
  font-size: 26rpx;
}
