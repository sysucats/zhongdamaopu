<!--components/searchCat/searchCat.wxml-->
<popup id='search' show="{{show}}" bind:close="hide">
  <view slot="header">
    <popup-header title="选择猫猫" close-position="none" />
    <view class='search-input'>
      <search-bar placeholder='{{text_cfg.genealogy.search_tip}}' focus="{{focusSearch}}" value='{{filters_input}}' bind:input='fSearchInput' bind:confirm='doSearchCat'></search-bar>
    </view>
  </view>
  <view class="search-cat-item {{item._disabled ? 'disabled' : ''}}" hover-class="item-hover" wx:for="{{searchCats}}" wx:key="_id" bindtap="searchSelectCat" data-index="{{index}}">
    <image mode="aspectFill" class="search-cat-avatar" src="{{item.avatar ? item.avatar.photo_compressed || item.avatar.photo_id : ''}}"></image>
    <view class="search-cat-info">
      <view class="search-cat-name">{{item.name}}</view>
      <view class="search-cat-location">{{item.campus}} {{item.area}}</view>
    </view>
    <view wx:if="{{item._disabled}}" class="search-cat-tag">已添加</view>
  </view>
  <view wx:if="{{!searchCats.length}}" class="search-empty">请搜索后进行选择</view>
</popup>
