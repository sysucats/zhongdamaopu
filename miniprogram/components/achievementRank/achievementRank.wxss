/* components/achievementRank/achievementRank.wxss — 金色主题 */
.achv-rank {
  padding: 24rpx 30rpx 40rpx;
}

.rank-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #7a5b12;
  text-align: center;
}

.rank-sub {
  font-size: 24rpx;
  color: #b5983f;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.rank-empty {
  text-align: center;
  color: #bfa760;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #fffdf6;
  border: 2rpx solid #f0e2b8;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 14rpx;
}

.rank-item.mine {
  border-color: #e6a823;
  background: #fdf6e0;
}

.rank-no {
  width: 56rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #b9a35f;
  text-align: center;
  flex-shrink: 0;
}

.rank-no.rank-1 { color: #e6a823; font-size: 36rpx; }
.rank-no.rank-2 { color: #9aa5b1; font-size: 34rpx; }
.rank-no.rank-3 { color: #c88a4b; font-size: 32rpx; }

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 20rpx 0 12rpx;
  flex-shrink: 0;
  background: #f0e2b8;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: #6b4f0e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #a0740a;
  flex-shrink: 0;
}

.rank-count-unit {
  font-size: 22rpx;
  font-weight: normal;
  color: #b5983f;
}

.my-rank {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a0740a;
  background: #f9ecc8;
  border-radius: 32rpx;
  padding: 18rpx;
}

.rank-loading {
  text-align: center;
  color: #bfa760;
  font-size: 26rpx;
  padding: 40rpx 0;
}
