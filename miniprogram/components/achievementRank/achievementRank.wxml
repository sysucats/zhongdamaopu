<!--components/achievementRank/achievementRank.wxml-->
<view class="achv-rank">
  <view class="rank-title">🏆 成就排行榜</view>
  <view class="rank-sub">按解锁成就数量排名</view>

  <view class="rank-empty" wx:if="{{!loading && list.length === 0}}">
    还没有人解锁成就，快去互动抢第一~
  </view>

  <view class="rank-item {{item.openid === myOpenid ? 'mine' : ''}}" wx:for="{{list}}" wx:key="openid">
    <view class="rank-no rank-{{item.rank}}" wx:if="{{item.rank <= 3}}">{{item.rank}}</view>
    <view class="rank-no" wx:else>{{item.rank}}</view>
    <image class="rank-avatar" src="{{item.avatarUrl || '/pages/public/images/app_logo.png'}}" mode="aspectFill" lazy-load="true"></image>
    <view class="rank-name">{{item.nickName}}</view>
    <view class="rank-count">{{item.count}}<text class="rank-count-unit"> 枚</text></view>
  </view>

  <!-- 我的排名（未上榜时提示） -->
  <view class="my-rank" bindtap="toMyAchievement" wx:if="{{myOpenid}}">
    <block wx:if="{{myRank > 0}}">我的排名：第 {{myRank}} 名（{{myCount}} 枚） →</block>
    <block wx:else>我还没上榜，点我去解锁成就 →</block>
  </view>

  <view class="rank-loading" wx:if="{{loading}}">加载中...</view>
</view>
