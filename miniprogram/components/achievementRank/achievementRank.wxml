<!--components/achievementRank/achievementRank.wxml-->
<view class="leaderboard-section">
  <view class="content-card" wx:if="{{profileLoaded && !hasProfile}}">
    <profile-prompt context="查看我的成就排名" bind:edit="editProfile" />
  </view>
  <view class="content-card leaderboard-summary" bindtap="toMyAchievement" wx:elif="{{hasProfile}}">
    <view class="leaderboard-summary-grid">
      <view class="leaderboard-summary-cell">
        <view class="leaderboard-summary-label">排名</view>
        <view class="leaderboard-summary-number" wx:if="{{myRank > 0}}">{{myRank}}</view>
        <view class="leaderboard-summary-status" wx:else>{{myCount > 0 ? '50名外' : '未上榜'}}</view>
      </view>
      <view class="leaderboard-summary-cell center">
        <image class="leaderboard-summary-avatar" mode="aspectFill" src="{{myAvatarUrl}}"></image>
        <view class="leaderboard-summary-name">{{myName}}</view>
      </view>
      <view class="leaderboard-summary-cell">
        <view class="leaderboard-summary-label">成就</view>
        <view class="leaderboard-summary-number">{{myCount || 0}}</view>
      </view>
    </view>
    <view class="leaderboard-summary-action">查看我的成就</view>
  </view>

  <view class="content-card leaderboard-list achievement-list" wx:if="{{list.length > 0}}">
    <view class="leaderboard-row rank-{{item.rank <= 3 ? item.rank : 0}}" wx:for="{{list}}" wx:key="openid">
      <view class="leaderboard-order">{{item.rank}}</view>
      <view class="leaderboard-avatar-wrap">
        <view class="leaderboard-avatar-inner">
          <image class="leaderboard-avatar" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load="true"></image>
          <image wx:if="{{item.rank <= 3}}" class="leaderboard-medal" mode="aspectFit" src="/pages/public/images/info/rank/{{item.rank}}.png"></image>
        </view>
      </view>
      <view class="leaderboard-name">{{item.nickName}}</view>
      <view class="leaderboard-value achievement-count" bindtap="openShowcase" data-openid="{{item.openid}}" data-name="{{item.nickName}}" aria-role="button" aria-label="查看{{item.nickName}}展示的成就">
        <text class="achievement-count-number">{{item.count}}</text><text class="leaderboard-unit">枚</text>
      </view>
    </view>
  </view>

  <view class="leaderboard-state" wx:if="{{!loading && list.length === 0}}">
    还没有人解锁成就，快去互动抢第一~
  </view>
  <view class="leaderboard-state" wx:if="{{loading}}">加载中...</view>
</view>

<modifyUserInfo show="{{showEdit}}" bind:close="closeEdit"></modifyUserInfo>
