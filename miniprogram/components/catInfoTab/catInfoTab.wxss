/* 猫咪信息编辑区域 */
@import "../../pages/public/wxss/iconfont.wxss";

@import "/pages/public/wxss/formControls.wxss";

.cat-info-section {
  padding: 0 var(--space-lg) 160rpx;
}

.edit-mode-indicator {
  margin-bottom: var(--space-md);
  color: var(--color-gray-max);
  font-size: 28rpx;
  text-align: center;
}

.cat-field {
  margin-bottom: var(--space-md);
}

.cat-field:last-child {
  margin-bottom: 0;
}

/* 人气 */
.popularity-info {
  text-align: right;
  font-size: 26rpx;
  color: var(--color-gray-max);
  padding: 10rpx 0 30rpx;
}

/* 照片网格 */
.photo-grid {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

/* 卡片 */
.photo-card {
  background-color: var(--color-surface);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.photo-container {
  position: relative;
  width: 100%;
  aspect-ratio: 5/4;
  overflow: hidden;
  background-color: var(--color-gray-light);
}

.photo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.best-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--color-primary);
  color: var(--color-text-onPrimary);
  opacity: 0.8;
  padding: 8rpx 0;
  font-size: 24rpx;
  text-align: center;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 照片信息 */
.photo-info {
  padding: 24rpx;
}

.photo-number {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--color-black-light);
  margin-bottom: 16rpx;
}

.photo-meta {
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.meta-label {
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.meta-value {
  font-size: 26rpx;
  color: var(--color-black-light);
  font-weight: 500;
}

.cat-danger-button {
  background: var(--color-gray-light);
}

.photo-actions {
  margin-top: 0;
}
.photo-actions .danger { margin-right: auto; }

/* 加载更多部分 */
.load-more-container {
  margin-top: 10rpx;
  margin-bottom: 30rpx;
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-animation {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 0;
}

.bottom-hint {
  width: 100%;
  text-align: center;
  color: var(--color-gray-max);
  font-size: 28rpx;
  margin-top: 10rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
