.achievement-detail {
  box-sizing: border-box;
  width: 620rpx;
  padding: 0 var(--space-lg) var(--space-lg);
}

.badge-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 370rpx;
}

.badge-art {
  position: relative;
  z-index: 1;
  width: 360rpx;
  height: 360rpx;
}
.award-stamp {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  color: var(--color-gray-dark);
  opacity: 0.65;
  transform: rotate(-12deg);
}

.stamp-ring {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  outline: 2rpx solid currentColor;
  outline-offset: -12rpx;
}

.stamp-caption,
.stamp-year {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stamp-day {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stamp-waves {
  position: absolute;
  left: 114rpx;
  width: 80rpx;
}

.stamp-wave {
  width: 100%;
  height: 16rpx;
  border-top: 3rpx solid currentColor;
  border-radius: 50%;
}

.badge-name {
  margin: 12rpx 0 28rpx;
  color: var(--color-black-light);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.condition-card {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--color-gray-light);
}

.condition-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.condition-title {
  flex: 1;
  min-width: 0;
  color: var(--color-black-light);
  font-size: 25rpx;
  font-weight: 600;
}

.condition-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-gray-max);
  border-radius: 999rpx;
  color: var(--color-gray-max);
  font-size: var(--font-size-tag);
}

.condition-progress {
  margin-top: 12rpx;
  color: var(--color-gray-max);
  font-size: 22rpx;
}
