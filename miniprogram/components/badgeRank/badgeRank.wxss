/* components/badgeRank/badgeRank.wxss */
@import "/pages/public/wxss/hFilter.wxss";
@import "/pages/public/wxss/card.wxss";

.h-filter-list {
  display: flex;
  justify-content: center;
}
.h-filter-item.long {
  margin: 20rpx 10rpx;
}

.tip {
  width: 100%;
  text-align: center;
  color: var(--color-gray-dark);
  font-size: 22rpx;
}

.badge-sections {
  padding: 0 var(--space-lg);
}

.badge-header {
  position: relative;
  z-index: 1;
  padding: 0 calc(60rpx - var(--space-lg));
  display: flex;
  flex-direction: row;
  align-items: center;
}

.badge-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.badge-info {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-sm);
}

.badge-name {
  overflow-wrap: anywhere;
  font-size: 28rpx;
}

.badge-desc {
  font-size: 22rpx;
  color: var(--color-black-transparent);
}

.badge-to-detail {
  font-size: 22rpx;
  flex-shrink: 0;
  white-space: nowrap;
  text-decoration: underline;
  color: var(--color-gray-dark);
}

/* 卡片从徽章下方开始，保留原来左上角图标的位置。 */
.badge-list {
  margin-top: -110rpx;
  padding-top: 120rpx;
}

.badge-cat {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
  align-items: center;
  padding: 0;
}

.badge-cat.hover {
  background-color: var(--color-gray-light);
}

.badge-cat-img {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 100%;
  margin-left: 20rpx;
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 70% 70%;
  background-image: var(--img-default);
}

.badge-cat-order {
  width: 30rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-gray-dark);
}

.badge-cat-order.highlight {
  color: var(--color-primary-text);
}

.badge-cat-info {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-sm);
}
.badge-to-detail, .badge-cat-count {
  margin-left: auto;
}

.badge-cat-name {
  overflow-wrap: anywhere;
  font-size: 30rpx;
}

.badge-cat-campus {
  font-size: 20rpx;
  color: var(--color-gray-dark);
}
.badge-cat-habit {
  font-size: 22rpx;
  color: var(--color-gray-max);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-cat-count {
  text-align: right;
  width: 40rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: bold;
}

.badge-cat-count.highlight {
  font-size: 28rpx;
  color: var(--color-primary-text);
  font-weight: bold;
}

/* 分等级颜色 */

.badge-level-A .badge-img {
  filter: drop-shadow(0rpx 0rpx 7rpx var(--color-badge-A));
  transform: translateZ(0);
}

.badge-level-B .badge-img {
  filter: drop-shadow(0rpx 0rpx 7rpx var(--color-badge-B));
  transform: translateZ(0);
}

.badge-level-C .badge-img {
  filter: drop-shadow(0rpx 0rpx 7rpx var(--color-badge-C));
  transform: translateZ(0);
}

.badge-level-A .badge-name {
  color: var(--color-badge-A);
}

.badge-level-B .badge-name {
  color: var(--color-badge-B);
}

.badge-level-C .badge-name {
  color: var(--color-badge-C);
}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  display: block;
  margin: 10rpx auto;
}