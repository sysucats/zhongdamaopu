:host { display: block; }
.badge-scene {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-fit { perspective: 900rpx; }
.badge-scene.locked { filter: grayscale(1); opacity: 0.45; }
.badge-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.loading-ring { width: 36rpx; height: 36rpx; border: 3rpx solid var(--color-gray-normal); border-top-color: var(--color-gray-max); border-radius: 50%; animation: spin 1s linear infinite; }
.badge-placeholder { display: flex; align-items: center; justify-content: center; color: var(--color-primary); font-size: 120rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

.badge-body {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 560ms ease-in-out;
}

.badge-body.flipped {
  transform: rotateY(180deg);
}

.badge-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.badge-back {
  transform: rotateY(180deg);
}
