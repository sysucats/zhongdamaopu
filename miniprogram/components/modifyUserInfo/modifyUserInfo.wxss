@import "/pages/public/wxss/formControls.wxss";
@import "/pages/public/wxss/iconfont.wxss";

.profile-editor {
  padding: 0 var(--space-sm) var(--space-md);
}

.profile-fields {
  padding-bottom: var(--space-md);
}

.avatar-wrapper::after {
  border: none;
}

.profile-avatar-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.profile-avatar-copy {
  flex: 1;
  min-width: 0;
}

.profile-avatar-copy .field-label {
  margin-bottom: 0;
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: var(--color-gray-light);
  overflow: visible;
}

.avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--color-surface);
  border-radius: 50%;
  background: var(--color-gray-normal);
  color: var(--color-black-min);
}

.avatar-edit .iconfont {
  font-size: 26rpx;
}

.profile-loading {
  padding: var(--space-xl);
  color: var(--color-gray-max);
  font-size: 26rpx;
  text-align: center;
}
