@import "./footprintShared.wxss";

.page {
  min-height: 0;
  padding: 0;
}

.footprint-section + .footprint-section {
  margin-top: var(--space-section);
}

.comment-card + .comment-card {
  margin-top: 70rpx;
}

.mosaic-likes {
  min-height: 44rpx;
  font-size: 24rpx;
}

.overview-heart-viewport {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.overview-heart-sprite {
  position: absolute;
  left: -18rpx;
  top: -18rpx;
  width: 80rpx;
  height: 80rpx;
}
