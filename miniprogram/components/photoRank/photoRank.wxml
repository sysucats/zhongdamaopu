<view class="leaderboard-section">
  <view class="leaderboard-card photo-auth" wx:if="{{!user}}">
    <view class="photo-auth-title">{{text_cfg.photo_rank.auth_tip_title}}</view>
    <button class="photo-auth-button" bindtap="getUInfo">{{text_cfg.photo_rank.auth_tip}}</button>
  </view>
  <view class="leaderboard-card leaderboard-summary" wx:else>
    <view class="leaderboard-summary-grid">
      <view class="leaderboard-summary-cell">
        <view class="leaderboard-summary-label">排名</view>
        <view class="leaderboard-summary-number" wx:if="{{user.photo_rank}}">{{user.photo_rank}}</view>
        <view class="leaderboard-summary-status" wx:else>未上榜</view>
      </view>
      <view class="leaderboard-summary-cell center">
        <image class="leaderboard-summary-avatar" mode="aspectFill" src="{{user.userInfo.avatarUrl || defaultAvatarUrl}}" bindtap="getUInfo"></image>
        <view class="leaderboard-summary-name">{{user.nickName}}</view>
      </view>
      <view class="leaderboard-summary-cell">
        <view class="leaderboard-summary-label">照片</view>
        <view class="leaderboard-summary-number">{{user.photo_count || 0}}</view>
      </view>
    </view>
  </view>

  <view class="leaderboard-card leaderboard-list photo-list" wx:if="{{ranks && ranks.length > 0}}">
    <view class="leaderboard-row rank-{{item.rank <= 3 ? item.rank : 0}}" wx:for="{{ranks}}" wx:key="_openid">
      <view class="leaderboard-order">{{item.rank}}</view>
      <view class="leaderboard-avatar-wrap">
        <view class="leaderboard-avatar-inner">
          <image class="leaderboard-avatar" mode="aspectFill" src="{{item.userInfo.avatarUrl || defaultAvatarUrl}}"></image>
          <image wx:if="{{item.rank <= 3}}" class="leaderboard-medal" mode="aspectFit" src="/pages/public/images/info/rank/{{item.rank}}.png"></image>
        </view>
      </view>
      <view class="leaderboard-name">{{item.userInfo.nickName || text_cfg.genealogy.photo_by_unknow_tip}}</view>
      <view class="leaderboard-value">{{item.count}}<text class="leaderboard-unit"> 张</text></view>
    </view>
  </view>

  <view class="leaderboard-state" wx:if="{{loading}}">加载中...</view>
  <view class="leaderboard-state" wx:elif="{{ranks.length === 0}}">暂无拍照月榜</view>
  <view class="leaderboard-meta" wx:if="{{rankTime}}">更新于 {{rankTime}}</view>
</view>

<modifyUserInfo show="{{showEdit}}" bind:close="closeEdit"></modifyUserInfo>
