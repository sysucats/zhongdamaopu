@import "/pages/public/wxss/tag.wxss";
@import "/pages/public/wxss/button.wxss";
@import "/pages/public/wxss/card.wxss";

page,
.news-page {
  background: var(--color-surface);
}

.news.title {
  margin-bottom: var(--space-sm);
  color: var(--color-black-light);
  font-size: var(--font-size-page);
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.news.row-container {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-bottom: var(--space-md);
}

.news.tag {
  margin: 0;
}

.news.user,
.news.time {
  min-width: 0;
  font-size: var(--font-size-caption);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.news.user {
  flex: 1;
  color: var(--color-gray-max);
}

.news.time {
  color: var(--color-gray-dark);
  text-align: right;
}

.news.content {
  margin-bottom: var(--space-md);
  color: var(--color-black-min);
  font-size: var(--font-size-body);
  font-weight: 400;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.news.editTime {
  margin-top: var(--space-md);
  color: var(--color-gray-dark);
  font-size: var(--font-size-caption);
  line-height: 1.6;
}

.news-management-actions .form-button {
  flex: 1;
  min-width: 0;
}

.loading image {
  display: block;
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 40rpx auto var(--space-sm);
}

.album {
  margin-bottom: var(--space-md);
}

.album-block {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.album-item {
  position: relative;
  padding-bottom: 100%;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-gray-light);
}

.alb-image {
  position: absolute;
  width: 100%;
  height: 100%;
}

.single-image {
  display: block;
  width: 100%;
  height: auto;
}

.verify-box {
  padding: var(--space-lg) 0;
  color: var(--color-gray-max);
  font-size: var(--font-size-section);
  text-align: center;
}
