<view class="form-page" wx:if="{{auth}}">
  <form bindsubmit="bindSubmit">
    <view class="form-section">
      <view class="section-title">基本信息</view>
      <view class="field-label">自定义昵称（选填）</view>
      <input class="field-input" name="name" type="text" placeholder="{{appName}}" bindinput="bindInputName" maxlength="{{namemaxlength}}" />
      <view class="field-counter">字数：{{namelength}}/{{namemaxlength}}</view>
      <view class="field-label spaced-label field-required">标题</view>
      <input class="field-input" name="title" type="text" bindinput="bindInputTitle" maxlength="{{titlemaxlength}}" />
      <view class="field-counter">字数：{{titlelength}}/{{titlemaxlength}}</view>
      <view class="field-label spaced-label field-required">公告分类</view>
      <view class="chip-row news-choices">
        <button class="chip news-choice {{item.checked ? 'active' : ''}}" wx:for="{{buttons}}" wx:key="id" data-id="{{item.id}}" bindtap="radioButtonTap">{{item.name}}</button>
      </view>
      <view class="field-label spaced-label">正文（选填）</view>
      <textarea class="description-input long-input" name="mainContent" placeholder="喵喵 喵喵喵" maxlength="{{maxlength}}" bindinput="bindInput"></textarea>
      <view class="field-counter">字数：{{length}}/{{maxlength}}</view>
    </view>
    <view class="form-section">
      <view class="section-title">图片配置</view>
      <view class="field-label">封面图</view>
      <view class="field-hint news-media-hint">封面图会在公告栏界面显示（长按删除）</view>
      <image wx:if="{{cover != 0}}" class="image-preview" src="{{cover.path}}" mode="aspectFill" bindtap="previewImg" data-url="{{cover.path}}" bindlongpress="deleteCover" />
      <view class="image-upload" wx:else bindtap="chooseCover" aria-role="button" aria-label="添加封面">
        <text class="iconfont icon-photo-up upload-icon"></text>
        <view class="upload-label">添加封面</view>
      </view>
      <view class="field-label spaced-label">图片</view>
      <view class="field-hint news-media-hint">长按删除图片</view>
      <view class="image-grid">
        <image class="image-thumb" wx:for="{{photos}}" wx:key="_id" src="{{item.file.path}}" mode="aspectFill" bindtap="previewImg" data-url="{{item.file.path}}" bindlongpress="deleteImg" data-index="{{index}}" />
        <view class="image-upload image-upload-tile" wx:if="{{photos.length < 9}}" bindtap="chooseImg" aria-role="button" aria-label="添加图片">
          <text class="iconfont icon-photo-up upload-icon"></text>
          <view class="upload-label">添加图片</view>
        </view>
      </view>
      <view class="field-counter">图片数目：{{photos.length}}/9</view>
    </view>
    <view class="form-section">
      <view class="status-row">
        <view class="status-copy">
          <view class="status-title">公告弹窗</view>
          <view class="field-hint">设置公告弹窗将会在小程序首页弹出此公告</view>
        </view>
        <switch checked="{{modalButtons[1].checked}}" color="var(--color-green)" bindchange="onModalSwitchChange" aria-label="公告弹窗" />
      </view>
    </view>
    <view class="save-bar"><button class="form-button primary save-button" form-type="submit">发布公告</button></view>
  </form>
</view>
<no-auth wx:else tip-text="{{tipText}}" tip-btn="{{tipBtn}}"></no-auth>
