@import "/pages/public/wxss/tag.wxss";
@import "/pages/public/wxss/card.wxss";
page {
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg)
    calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-gray-light);
}

.news-box {
  display: flex;
  justify-content: space-between;
  gap: var(--space-lg);
  overflow: hidden;
}

.news.infoBox{
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  flex: 1;
  min-width: 0;
}

.news.title {
  font-size: var(--font-size-section);
  font-weight: 600;
  margin-bottom: var(--space-xs);
}

.news .row-container{
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);

}
.news.tag {
  margin: 0;
}

.news.user {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-caption);
  color: var(--color-gray-dark);

  white-space: nowrap;  
  text-overflow:ellipsis; 
  overflow:hidden;
}
.news.time {
  min-width: 0;
  font-size: var(--font-size-caption);
  color: var(--color-gray-dark);
  flex: 0 1 auto;
  text-align: right;
  white-space: nowrap;  
  text-overflow:ellipsis; 
  overflow: hidden;
}

.news.content-wrapper{

  flex-grow: 1;
}
.news.content {
  font-size: var(--font-size-body);
  font-weight: 400;
  /* letter-spacing:0.005rpx; */

  margin-bottom: var(--space-sm);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  color: var(--color-gray-max);

}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  display: block;
  margin: 10rpx auto;
  margin-top: 40rpx;
}

.cover-image {
  width: 200rpx;
  height: 200rpx;

  border-radius: var(--radius-md);

  flex-shrink: 0;
  /* flex-grow: 1; */
}



.button_container {
  display: flex;
  flex-direction: row;
  margin: var(--space-md) 0;
  width: 100%;
  height: 130rpx;
}

/* 按钮未选中 */
.normal_button {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  border-bottom: 5rpx solid transparent;
  background: transparent;
  padding: 8rpx 5rpx;
  box-sizing: border-box;
  transition: background-color 500ms ease,
              border-color 500ms ease,
              color 500ms ease,
              font-weight 500ms ease;
}

/* 按钮选中 */
.checked_button {
  border-color: var(--color-primary-dark);
  color: var(--color-primary-text);
  font-weight: bold;
}

.tab-logo{
  width: 80rpx;
  height: 86rpx;
  padding: 8rpx 10rpx;
  transition: background-color 500ms ease,
              border-color 500ms ease,
              color 500ms ease,
              font-weight 500ms ease;
}
.checked_button .tab-logo {
background-color: var(--color-primary-light);
border-radius: 10rpx;
}

.tab-text{
  font-size: 24rpx;
  text-align: center;
}

.checked_button.tab-text{
  color: var(--color-primary-text);
  font-weight: 500;
}

swiper {
  width: 100%;
  height: 261rpx;
  margin: 0 0 var(--space-md);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

swiper image {
  width: 100%;
  height: 261rpx;
  border-radius: var(--radius-xl);
}

.emptyImg {
  width: 100%;
  height: 100rpx;
  margin: 30rpx 0;
}
