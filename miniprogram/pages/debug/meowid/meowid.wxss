/* pages/debug/meowid/meowid.wxss */
/* 配色统一取 app.wxss 的预定义变量，不新增色值 */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
  background: var(--color-gray-light);
}

.tip {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: var(--color-comment-paper-white);
}

.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-primary-text);
}

.badge {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: normal;
  line-height: 1.6;
}

.badge-on {
  background: var(--color-comment-paper-green);
  color: var(--color-green-dark);
}

.badge-off {
  background: var(--color-gray-normal);
  color: var(--color-gray-max);
}

.field {
  margin-bottom: 24rpx;
}

.field-name {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--color-primary-text);
}

/* 输入框与 picker 展示框共用同一外框 */
.field-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-gray);
  border-radius: 12rpx;
  background: var(--color-white-dark);
  font-size: 27rpx;
  color: var(--color-black-min);
}

/* picker 里是普通 view，需显式垂直居中；原生 input 自带居中 */
.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-arrow {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--color-gray-max);
}

/* 同步进度：灰底内嵌块，数值加粗、进度条复用主色 */
.stats {
  padding: 20rpx;
  margin-bottom: 24rpx;
  border-radius: 14rpx;
  background: var(--color-gray-light);
}

.stat + .stat {
  margin-top: 18rpx;
}

.stat-line {
  display: flex;
  align-items: baseline;
  font-size: 25rpx;
  color: var(--color-black-min);
}

.stat-label {
  flex: none;
  width: 64rpx;
  font-size: 23rpx;
  color: var(--color-gray-max);
}

.stat-main {
  flex: 1;
}

.stat-num {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-primary-text);
}

.stat-rest {
  font-size: 23rpx;
  color: var(--color-gray-max);
}

.stat-bar {
  height: 8rpx;
  margin: 10rpx 0 0 64rpx;
  border-radius: 999rpx;
  background: var(--color-gray-normal);
  overflow: hidden;
}

.stat-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
  transition: width 0.3s;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn {
  flex: 1 1 40%;
  box-sizing: border-box;
  height: 76rpx;
  margin: 0;
  padding: 0 16rpx;
  line-height: 74rpx;
  border: 1rpx solid var(--color-gray);
  border-radius: 14rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: 26rpx;
  font-weight: 500;
}

.btn::after {
  border: 0;
}

.btn-primary {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
}

.btn[disabled] {
  border-color: var(--color-gray-normal);
  background: var(--color-gray-normal);
  color: var(--color-gray-max);
}

.hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--color-gray-max);
  line-height: 1.6;
}
