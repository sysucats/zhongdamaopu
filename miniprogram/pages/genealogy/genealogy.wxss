/* 卡片操作按钮配色：仅本页使用（鼠尾草绿 / 杏橙 / 柔和黄） */
page {
  --genealogy-btn-upload: #6FB58A;
  --genealogy-btn-comment: #E89B6C;
  --genealogy-btn-detail: #F0C04A;
  /* 浮动搜索区高度：上 24 + 搜索框 80 + 下 16（校区行自带 8rpx 内边距，合起来也是 24） */
  --search-area: 120rpx;
}

/* miniprogram/pages/genealogy/genealogy.wxss */
@import "/pages/public/wxss/hFilter.wxss";
@import "/pages/public/wxss/button.wxss";

page {
  height: 100%;
  background-color: var(--color-gray-light);
}
/* 下面开始猫卡布局 */
scroll-view {
  -webkit-overflow-scrolling: touch;
  z-index: 0;
  background-color: var(--color-gray-light);
}

.cards {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

/* 浮动搜索栏的占位：纵向 flex 里不允许被压缩 */
.search-spacer {
  flex-shrink: 0;
  height: var(--search-area);
  width: 100%;
}

/* 校区行自带 8rpx 内边距，再加 16rpx，胶囊到卡片的可见间距为 24rpx */
.cards .h-filter-list {
  margin-bottom: var(--space-sm);
}

.card {
  margin-bottom: 50rpx;
  font-size: 24rpx;
  line-height: 24rpx;
  width: 625rpx;
  border-radius: 15rpx;

  box-sizing: border-box;
  background-color: var(--color-surface);

  box-shadow: 13rpx 13rpx 30rpx var(--color-gray);
  position: relative;
  /* TODO：重写为flex布局 */

  /* 平滑过渡：宽度、阴影、上浮、圆角在展开/收起时动画 */
  transition: width 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease, margin 0.3s ease;
  z-index: 1;
}

.card.wide {
  width: 700rpx;
  /* 高级感：更强的投影 + 主题色高光 + 轻微上浮 */
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.22), 0 4rpx 12rpx rgba(255, 209, 1, 0.25);
  transform: translateY(-6rpx);
  z-index: 100;
}

.card view.image {
  height:590rpx;
  border-radius: 15rpx 15rpx 0 0;
  position: relative;
  overflow: hidden;
  background-color: var(--color-gray-light);
  background-image: var(--img-default);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 50% 50%;
}

.card.wide view.image {
  height:500rpx;
}

.card view.image .image-title{
  width: 100%;
  height: 40rpx;
  line-height: 40rpx;
  background-color: var(--color-black-light);
  opacity: .4;
  text-align: center;
  color: var(--color-text-inverse);
  position: absolute;
  bottom: 0;
}

.card view.image image {
  width: 100%;
  /* widthFix 模式下高度按图片比例自适应，移除固定 height */
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  will-change: transform;
}

/* aspectFill 模式（横屏照片填满容器）：需明确高度 100% 才能填满 */
.card view.image image.mode-fill {
  height: 100%;
}

/* 竖屏照片自动上下往返：CSS animation infinite alternate 由渲染引擎驱动，
   无需 JS transitionend 切换方向，避免到顶/底时因 setData 异步导致的闪烁 */
.card view.image image.pan-animate {
  animation: cardPhotoPan var(--pan-duration, 6s) ease-in-out infinite alternate;
}

@keyframes cardPhotoPan {
  from { transform: translateY(0); }
  to   { transform: translateY(calc(var(--pan-distance, 0px) * -1)); }
}

.card view.image.to_star image {
  filter: grayscale(100%);
}

.card .info {
  padding: 35rpx 35rpx 20rpx 35rpx;
}

.card .hoverInfo{
  background-color: var(--color-gray-light);
  border-radius: 15rpx;
}

.card .info .name {
  height: 30rpx;
  font-size: 33rpx;
  line-height: 30rpx;

  font-weight: 600;
  letter-spacing: 2rpx;

  /* 猫咪名字过长时，省略号处理 */
  max-width: 250rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card .info image.gender {
  height: 27rpx;
  width: 27rpx;
  margin-right: 15rpx;
  margin-left: 8rpx;
}

.card .info .line.cat-heading {
  display: block;
}
.cat-heading::after {
  content: "";
  display: block;
  clear: both;
}
.cat-heading-counts {
  float: right;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 64rpx;
  white-space: nowrap;
  margin-left: var(--space-sm);
}
.cat-heading .cat-status-rows {
  display: inline-flex;
  max-width: 100%;
  vertical-align: middle;
}
.cat-name-group {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 100%;
  min-height: 64rpx;
  margin-right: var(--space-xs);
  vertical-align: middle;
}

.card .info .popularity {
  margin-left: auto;
  order: 2;
  display: flex;
  align-items: center;
}
.iconfont {
  font-size: 25rpx;
  margin-right: 8rpx;
}
.iconfont.gray {
  color: var(--color-gray-dark);
}
.iconfont.primary {
  color: var(--color-primary);
}

.card .info .comment {
  margin-left: 15rpx;
  order: 2;
  display: flex;
  align-items: center;
}
.comment image {
  height: 27rpx;
  width: 27rpx;
  margin-right: 8rpx;
}

.card .line {
  display: flex;
  /* align-items: flex-start; */
  vertical-align: baseline;
  margin-bottom: 10rpx;

  color: var(--color-black-min);
  line-height: 1.05rem;
}

.card .line:first-child{
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  margin-left: 3rpx;
}

.card .line image.icon {
  height: 28rpx;
  width: 28rpx;
  min-width: 26rpx;
  margin-right: 20rpx;
  vertical-align: text-top;
}

.card .line .index {
  margin-left:auto;
  order:2;
  color: var(--color-gray);
}

.card .line .characteristics{
  line-height: 1.05rem;
  vertical-align: text-top;
}

.card .line .habit{
  line-height: 1.05rem;
  vertical-align: text-top;
}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx 200rpx 292rpx;
}
.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: 10rpx 0 200rpx 0;
}

/* 新图标签 */
.card .label {
  display: inline-block;
  text-align: left;
  background-color: var(--color-primary);
  border-color: var(--color-primary-dark);
  color: var(--color-text-onPrimary);
  border-radius: 0 10rpx 10rpx 0;
  padding: 10rpx;
  font-size: 22rpx;
  position: absolute;
  top: 30rpx;
  left: -17.5rpx;
  z-index: 1;
}

.card .label::after {
    position: absolute;
    top: 100%;
    right: auto;
    left: 0;

    border-style: solid;
    border-width: 0 17.5rpx 17.5rpx 0;
    border-color: transparent;
    border-top-color: inherit!important;
    background-color: transparent!important;
    border-right-color: inherit!important;

    content: '';
    width: 0;
    height: 0;
}

/* 展开卡片的动作按钮组：底部三个按钮（上传喵照 / 便利贴墙 / 猫猫详情） */
.card-action-row {
  display: flex;
  margin: 24rpx 0 8rpx;
  gap: 16rpx;
  z-index: 5;
  animation: cardBtnFadeIn 0.3s ease 0.1s both;
}

.card-action-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 20rpx 0;
  border-radius: 14rpx;
  color: var(--color-text-inverse);
}

.card-action-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 上传喵照：柔和绿（鼠尾草绿） */
.card-action-btn.btn-upload {
  background: var(--genealogy-btn-upload);
  box-shadow: 0 4rpx 12rpx rgba(111, 181, 138, 0.35);
}

/* 便利贴墙：柔和橙（杏橙） */
.card-action-btn.btn-comment {
  background: var(--genealogy-btn-comment);
  box-shadow: 0 4rpx 12rpx rgba(232, 155, 108, 0.35);
}

/* 猫猫详情：柔和黄 */
.card-action-btn.btn-detail {
  background: var(--genealogy-btn-detail);
  box-shadow: 0 4rpx 12rpx rgba(240, 192, 74, 0.4);
}

/* 右上角"管理"按钮（仅管理员） */
.card-manage-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  z-index: 5;
  animation: cardBtnFadeIn 0.3s ease 0.1s both;
}

.card-manage-btn:active {
  opacity: 0.8;
  background: rgba(0, 0, 0, 0.7);
}

@keyframes cardBtnFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 广告栏 */

.card-ad {
  margin-bottom: 50rpx;
  width: 635rpx;
  border-radius: 15rpx;
  background-color: var(--color-surface);
  box-shadow: 13rpx 13rpx 30rpx var(--color-gray);
  overflow: hidden;

  display: flex;
  justify-content: center;
  align-items: center;

  min-height: 200rpx;
  box-sizing: border-box;

}

.card-ad.hidden {
  display: none;
}

/* 顶部的搜索框还有筛选 */
#search {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 750rpx;
  height: var(--search-area);
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg) 0;
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

/* 筛选卡片展开时，搜索栏抬到蒙层之上，保持可见可用 */
#search.panel-open {
  z-index: 61;
}

/* 搜索框本体见 components/searchBar */
.search-field {
  flex: 1;
  min-width: 0;
}

/* 拍照识别：框内尾部图标，前面一道短分隔线 */
.recognize-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 64rpx;
  margin-left: 8rpx;
  color: var(--color-black-min);
}

.recognize-btn::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 1rpx;
  height: 32rpx;
  margin-top: -16rpx;
  background-color: var(--color-gray-normal);
}

.recognize-btn .iconfont {
  display: block;
  font-size: 40rpx;
  line-height: 1;
}

/* 筛选：圆形按钮；生效时浅黄底黄描边，角标显示已筛项数 */
.filter-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 1rpx solid var(--glass-border);
  background-color: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  color: var(--color-black-min);
  box-sizing: border-box;
}

.filter-btn .iconfont {
  display: block;
  font-size: 38rpx;
  line-height: 1;
  /* 漏斗字形右侧留白较多，视觉上偏左，补回约 2px */
  transform: translateX(4rpx);
}

/* 卡片展开中：白底黄描边 */
.filter-btn.open {
  border: 3rpx solid var(--color-primary);
  background-color: var(--color-surface);
  color: var(--color-primary-text);
}

.filter-btn.active {
  border: 3rpx solid var(--color-primary);
  background-color: var(--color-primary-light);
  color: var(--color-primary-text);
}

.filter-count {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: var(--radius-pill);
  border: 3rpx solid var(--color-surface);
  background-color: var(--color-primary);
  color: var(--color-black-light);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 筛选蒙层：浅色，只用来提示「点外面收起」 */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background-color: rgba(0, 0, 0, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.filter-mask.show {
  opacity: 1;
  pointer-events: auto;
}

/* 筛选卡片：从筛选按钮下方展开，左右与搜索栏对齐；蒙层 z 60，搜索栏 61，卡片 62 */
.filter-card {
  position: fixed;
  top: var(--search-area);
  left: var(--space-lg);
  right: var(--space-lg);
  z-index: 62;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background-color: var(--color-surface);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.18);
  transform-origin: top right;
  opacity: 0;
  transform: translateY(-12rpx) scale(0.97);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.25s cubic-bezier(.3, .7, .2, 1);
}

.filter-card.show {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

/* 分组标签：与榜单频道栏同一套下划线 */
.filter-tabs {
  position: relative;
  flex-shrink: 0;
  display: flex;
  height: 84rpx;
  border-bottom: 1rpx solid var(--color-gray-normal);
}

.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-gray-max);
  font-size: var(--font-size-body);
}

.filter-tab.active {
  color: var(--color-black-light);
  font-weight: 600;
}

.filter-tab-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
  color: var(--color-primary-text);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.filter-tab-indicator {
  position: absolute;
  bottom: 10rpx;
  width: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary-dark);
  transition: left 300ms cubic-bezier(.3, .7, .2, 1);
}

/* 页面给所有 scroll-view 铺了灰底，这里改回卡片白 */
.filter-body {
  background-color: var(--color-surface);
  /* 卡片最高到窗口底部留 32rpx：减去分组标签 84rpx 和按钮区 116rpx */
  max-height: calc(100vh - var(--search-area) - 232rpx);
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.filter-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm) 12rpx;
  padding: var(--space-md);
}

.filter-group {
  border-top: 1rpx solid var(--color-gray-normal);
}

.filter-group .filter-chip-row {
  padding-top: var(--space-sm);
}

.filter-group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-md) var(--space-md) 0;
  color: var(--color-black-light);
  font-size: 26rpx;
  font-weight: 600;
}

.filter-group-hint {
  color: var(--color-gray-max);
  font-size: 22rpx;
  font-weight: 400;
}

/* 选项胶囊：与外显校区行一致，未选灰描边，选中黄描边浅黄底 */
.filter-chip {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-gray-normal);
  border-radius: var(--radius-pill);
  color: var(--color-black-min);
  font-size: var(--font-size-chip);
  box-sizing: border-box;
}

.filter-chip.active {
  border-color: var(--color-primary);
  background-color: var(--color-primary-light);
  color: var(--color-primary-text);
  font-weight: 600;
}

.filter-actions {
  flex-shrink: 0;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md) var(--space-md);
  border-top: 1rpx solid var(--color-gray-normal);
}

/* 按钮样式见 public/wxss/button.wxss，这里只管两颗按钮的宽度分配 */
.filter-actions .form-button {
  /* 卡片内按钮比公共默认 88rpx 稍矮 */
  --form-button-height: 76rpx;
  flex: 1;
}

.filter-actions .reset-button {
  flex: 0 0 34%;
}

/* 寻找领养按钮 */
#find-adopt {
  position: fixed;
  bottom: 300rpx;
  right: 30rpx;
  z-index: 50;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;

  filter: drop-shadow(0 0 5rpx var(--color-gray-dark));
  transform: translateZ(0);
}

/* 返回首页 */
#back-to-firstpage {
  position: fixed;
  bottom: 200rpx;
  right: 30rpx;
  z-index: 50;

  filter: drop-shadow(0 0 5rpx var(--color-gray-dark));
  transform: translateZ(0);
}

#find-adopt .logo {
  width: 99rpx;
  height: 50rpx;
  display: block;
}

#find-adopt .count {
  font-size: 20rpx;
  padding: 1rpx 10rpx;
  background-color: var(--color-primary);
  border-radius: 5rpx;
  color: var(--color-black-light);
}

.adopt-filter-tip {
  position: fixed;
  top: var(--search-area);
  right: 20rpx;
  opacity: 1;

  transition: transform 1s, opacity 1s;
}

.adopt-filter-tip.hide {
  opacity: 0;
  transform: translateY(-25px);
}

.adopt-filter-tip .tri {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 10rpx 10rpx 10rpx;
  border-color: transparent transparent var(--color-black-transparent) transparent;

  position: absolute;
  right: 20rpx;
}

.adopt-filter-tip .content {
  width: 180rpx;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx;
  background-color: var(--color-black-transparent);
  color: var(--color-text-inverse);

  border-radius: 10rpx;
  
  position: absolute;
  right: 0;
  top: 10rpx;
}

.shake {
  /* 摇晃动画 */
  animation-name: upAnimation;
  animation-duration: 2s;
  animation-fill-mode: both;
  animation-iteration-count: 6;
  animation-delay: 2s;
}
@keyframes upAnimation {
  0% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  10% {
      transform: rotate(-12deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  20% {
      transform: rotate(12deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  28% {
      transform: rotate(-10deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  36% {
      transform: rotate(10deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  42% {
      transform: rotate(-8deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  48% {
      transform: rotate(8deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  52% {
      transform: rotate(-4deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  56% {
      transform: rotate(4deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  60% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  100% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }
}


#back-to-firstpage .back-btn {
  width: 80rpx;
  height: 80rpx;
  margin: 0rpx 10rpx;
  display: block;
}

.news-container {
  z-index: 99;
}
/* 猫猫评分 */
.stars {
  width: 220rpx;
  height: 30rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.one-star {
  width: 30rpx;
  height: 30rpx;
}

.one-star.gray {
  filter: grayscale(100%);
  opacity: 0.3;
}

.one-star image {
  width: 100%;
  height: 100%;
}

.score {
  margin-left: 20rpx;
  width: 30rpx;
  text-align: center;
  color: var(--color-primary);
  font-weight: bold;
}

/* 校区胶囊行与搜索栏对齐：首尾胶囊距屏幕边缘 32rpx（页面通用边距 --space-lg），扣掉胶囊自带的 8rpx 外边距 */
.h-filter-scroll .h-filter-content {
  padding-left: calc(var(--space-lg) - var(--space-xs));
  padding-right: calc(var(--space-lg) - var(--space-xs));
}
