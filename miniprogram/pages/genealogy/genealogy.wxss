  font-weight: bold;
}

/* 校区胶囊行与搜索栏对齐：首尾胶囊距屏幕边缘 32rpx（页面通用边距 --space-lg），扣掉胶囊自带的 8rpx 外边距 */
.h-filter-scroll .h-filter-content {
  padding-left: calc(var(--space-lg) - var(--space-xs));
  padding-right: calc(var(--space-lg) - var(--space-xs));
}
