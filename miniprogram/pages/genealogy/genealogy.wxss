page {
  /* 浮动搜索区高度：上 24 + 搜索框 80 + 下 16（校区行自带 8rpx 内边距，合起来也是 24） */
  --search-area: 120rpx;
}

/* miniprogram/pages/genealogy/genealogy.wxss */
@import "/pages/public/wxss/hFilter.wxss";
@import "/pages/public/wxss/button.wxss";

page {
  height: 100%;
  background-color: var(--color-gray-light);
}
/* 下面开始猫卡布局 */
scroll-view {
  -webkit-overflow-scrolling: touch;
  z-index: 0;
  background-color: var(--color-gray-light);
}

.cards {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

/* 浮动搜索栏的占位：纵向 flex 里不允许被压缩 */
.search-spacer {
  flex-shrink: 0;
  height: var(--search-area);
  width: 100%;
}

/* 校区行自带 8rpx 内边距，再加 16rpx，胶囊到卡片的可见间距为 24rpx */
.cards .h-filter-list {
  margin-bottom: var(--space-sm);
}

.card {
  position: relative;
  z-index: 1;
  width: 625rpx;
  margin-bottom: 50rpx;
  border-radius: var(--radius-xl);
  box-sizing: border-box;
  background-color: var(--color-surface);
  /* 均匀轻投影，不再向右下偏移 */
  box-shadow: var(--shadow-card);
  font-size: 24rpx;
  /* 平滑过渡：宽度、阴影、上浮在展开/收起时动画 */
  transition: width 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease, margin 0.3s ease;
}

.card.wide {
  /* 只压住相邻卡片（1）；根节点 fixed 浮层为 50~63，滑动时不能被展开卡片盖过 */
  z-index: 2;
  width: 700rpx;
  /* 展开后浮起一层 */
  box-shadow: var(--shadow-float);
  transform: translateY(-6rpx);
}

.card view.image {
  position: relative;
  height: 590rpx;
  overflow: hidden;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  background-color: var(--color-gray-light);
  background-image: var(--img-default);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 50% 50%;
}

.card.wide view.image {
  height: 500rpx;
}

/* 无封面照片：暖色插画铺满占位区（aspectFill），文字压在底部渐隐层上 */
.card view.image.no-photo {
  height: 240rpx;
  background-image: none;
}

.card view.image.no-photo .no-cover-art {
  height: 100%;
}

.card view.image.no-photo .photo-overlay {
  padding-top: 28rpx;
}

.card view.image > image {
  width: 100%;
  /* widthFix 模式下高度按图片比例自适应，移除固定 height */
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  will-change: transform;
}

/* aspectFill 模式（横屏照片填满容器）：需明确高度 100% 才能填满 */
.card view.image > image.mode-fill {
  height: 100%;
}

/* 竖屏照片自动上下往返：CSS animation infinite alternate 由渲染引擎驱动，
   无需 JS transitionend 切换方向，避免到顶/底时因 setData 异步导致的闪烁 */
.card view.image > image.pan-animate {
  animation: cardPhotoPan var(--pan-duration, 6s) ease-in-out infinite alternate;
}

@keyframes cardPhotoPan {
  from { transform: translateY(0); }
  to   { transform: translateY(calc(var(--pan-distance, 0px) * -1)); }
}

.card view.image.to_star > image {
  filter: grayscale(100%);
}

/* 照片上的磨砂胶囊：左上「新照片」、右上「管理」 */
.photo-chip {
  position: absolute;
  top: 20rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx 0 16rpx;
  border: 1rpx solid var(--glass-dark-border);
  border-radius: var(--radius-pill);
  background-color: var(--glass-dark-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.photo-chip.new-photo {
  left: 20rpx;
}

.new-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
}

.new-photo-time {
  margin-left: 6rpx;
  font-weight: 400;
  opacity: 0.8;
}

.photo-chip.card-manage-btn {
  right: 20rpx;
  padding: 0 22rpx;
  font-weight: 500;
  animation: cardBtnFadeIn 0.3s ease 0.1s both;
}

.photo-chip.card-manage-btn:active {
  background-color: var(--glass-dark-bg-active);
}

/* 照片底部渐隐：名字、状态胶囊、拍摄者压在上面 */
.photo-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 92rpx 28rpx 20rpx;
  background: var(--grad-photo-overlay);
  color: var(--color-text-inverse);
}

.overlay-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.overlay-head .name {
  max-width: 300rpx;
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overlay-head image.gender {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}

.overlay-counts {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 20rpx;
  margin-left: auto;
  color: var(--color-text-inverse);
  font-size: 24rpx;
  font-weight: 600;
}

.overlay-counts .count {
  display: flex;
  align-items: center;
}

/* 热度、留言图标都用主题黄 */
.overlay-counts .iconfont {
  margin-right: 6rpx;
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 1;
}

.overlay-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.overlay-chips .cat-status-rows {
  display: flex;
}

/* 花色、位置：白色半透明胶囊 */
.overlay-chip {
  display: flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill);
  background-color: var(--glass-light-bg);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
  font-size: 22rpx;
  box-sizing: border-box;
}

.overlay-chip .iconfont {
  margin-right: 6rpx;
  font-size: 22rpx;
  line-height: 1;
}

.overlay-credit {
  color: var(--color-text-inverse-secondary);
  font-size: 20rpx;
}

/* 照片下方：生日、特征、性格逐行，底栏左评分右序号 */
.card .info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx 32rpx 32rpx;
}

.card .hoverInfo {
  background-color: var(--color-gray-light);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
}

.iconfont {
  font-size: 25rpx;
  margin-right: 8rpx;
}

.card .line {
  display: flex;
  align-items: flex-start;
  color: var(--color-black-min);
  font-size: 26rpx;
  line-height: 1.55;
}

.card .line .iconfont {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: var(--color-gray-dark);
  font-size: 26rpx;
  line-height: 40rpx;
}

.info-foot {
  display: flex;
  align-items: center;
  min-height: 36rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-gray-normal);
}

/* 上方没有生日/特征/性格行时，分割线与上留白都多余，底栏直接展示页码 */
.info-foot.no-detail {
  padding-top: 0;
  border-top: none;
}

.info-foot .index {
  margin-left: auto;
  color: var(--color-gray);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx 200rpx 292rpx;
}
.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: 10rpx 0 200rpx 0;
}

/* 展开卡片的动作按钮组：底部三个按钮（上传喵照 / 便利贴墙 / 猫猫详情） */
.card-action-row {
  display: flex;
  margin-top: 8rpx;
  gap: 16rpx;
  z-index: 5;
  animation: cardBtnFadeIn 0.3s ease 0.1s both;
}

/* 两个次按钮灰底、「详情相册」黄底，样式见 public/wxss/button.wxss */
.card-action-btn {
  --form-button-height: 72rpx;
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
}

@keyframes cardBtnFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 广告栏 */

.card-ad {
  /* 原生模板广告：外层与猫卡片同宽，圆角、投影同猫卡片。
     优选模式下有的样式只画约 300px，不能铺满，所以广告按自身宽度在卡片里水平居中，两侧留白对称。
     外层不能 overflow: hidden：容器初始高度为 0 时广告被整个裁掉，不会加载 */
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 625rpx;
  margin-bottom: 50rpx;
  border-radius: var(--radius-xl);
  background-color: var(--color-surface);
  box-shadow: var(--shadow-card);
}

/* 不定宽度：样式能铺满时自然铺满，画不满时按实际宽度居中 */
.card-ad-inner {
  display: block;
  max-width: 100%;
  /* 圆角裁在广告组件自身上，同猫卡片 */
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.card-ad.hidden {
  display: none;
}

/* 自定义导航栏：状态栏 + 胶囊行，名字靠左；层级高于筛选蒙层（60） */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 61;
  height: var(--nav-bottom, 176rpx);
  background-color: var(--color-primary);
  transition: box-shadow 0.2s ease;
}

.nav-bar.collapsed {
  box-shadow: var(--shadow-card);
}

.nav-title {
  position: absolute;
  /* 和胶囊同高、顶边对齐 */
  top: var(--cap-top, 48rpx);
  height: var(--cap-h, 64rpx);
  left: var(--space-lg);
  display: flex;
  align-items: center;
  color: var(--color-text-main);
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* 搜索行：展开时在导航栏下方，滚过阈值后由 collapseNav.wxs 先收窄变矮、再升进胶囊左侧 */
#search {
  position: fixed;
  top: var(--search-top, 0);
  left: 0;
  z-index: 62;
  width: 750rpx;
  box-sizing: border-box;
  padding: 0 var(--space-lg);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  will-change: transform;
}

/* 搜索框本体见 components/searchBar */
.search-field {
  flex: 1;
  min-width: 0;
}

/* 拍照识别：框内尾部图标，前面一道短分隔线 */
.recognize-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: calc(var(--search-h, 80rpx) - 16rpx);
  margin-left: 8rpx;
  color: var(--color-black-min);
}

.recognize-btn::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 1rpx;
  height: 32rpx;
  margin-top: -16rpx;
  background-color: var(--color-gray-normal);
}

.recognize-btn .iconfont {
  display: block;
  font-size: 40rpx;
  line-height: 1;
}

/* 筛选：圆形按钮；生效时浅黄底黄描边，角标显示已筛项数 */
.filter-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--search-h, 80rpx);
  height: var(--search-h, 80rpx);
  border-radius: 50%;
  border: 1rpx solid var(--glass-border);
  background-color: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  color: var(--color-black-min);
  box-sizing: border-box;
  /* 状态切换与筛选卡片弹出同时长、同曲线；宽高由 collapseNav.wxs 逐帧写，不加过渡 */
  transition: background-color 0.25s cubic-bezier(.3, .7, .2, 1), border-color 0.25s cubic-bezier(.3, .7, .2, 1),
    border-width 0.25s cubic-bezier(.3, .7, .2, 1), color 0.25s cubic-bezier(.3, .7, .2, 1), transform 0.15s ease;
}

/* 按下：轻微缩小，松手回弹 */
.filter-btn.pressed {
  transform: scale(0.9);
}

.filter-btn .iconfont {
  display: block;
  font-size: 38rpx;
  line-height: 1;
  /* 漏斗字形右侧留白较多，视觉上偏左，补回约 2px */
  transform: translateX(4rpx);
}

/* 卡片展开中：白底黄描边 */
.filter-btn.open {
  border: 3rpx solid var(--color-primary);
  background-color: var(--color-surface);
  color: var(--color-primary-text);
}

.filter-btn.active {
  border: 3rpx solid var(--color-primary);
  background-color: var(--color-primary-light);
  color: var(--color-primary-text);
}

.filter-count {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: var(--radius-pill);
  border: 3rpx solid var(--color-surface);
  background-color: var(--color-primary);
  color: var(--color-black-light);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 蒙层外层：固定定位 + z-index 自成层叠上下文，mask 组件内部的层级再大也只在 z 60 这一层里，
   不会越过导航栏 61、搜索栏 62、筛选卡片 63。零尺寸、不挡点击，组件自身仍铺满屏幕 */
.mask-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  z-index: 60;
}

/* 筛选卡片：从筛选按钮下方展开，左右与搜索栏对齐；蒙层 z 60，导航栏 61，搜索栏 62，卡片 63 */
.filter-card {
  position: fixed;
  top: var(--filter-top, var(--search-area));
  left: var(--space-lg);
  right: var(--space-lg);
  z-index: 63;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background-color: var(--color-surface);
  box-shadow: var(--shadow-float);
  transform-origin: top right;
  opacity: 0;
  transform: translateY(-12rpx) scale(0.97);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.25s cubic-bezier(.3, .7, .2, 1);
}

.filter-card.show {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

/* 分组标签：与榜单频道栏同一套下划线 */
.filter-tabs {
  position: relative;
  flex-shrink: 0;
  display: flex;
  height: 84rpx;
  border-bottom: 1rpx solid var(--color-gray-normal);
}

.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-gray-max);
  font-size: var(--font-size-body);
}

.filter-tab.active {
  color: var(--color-black-light);
  font-weight: 600;
}

.filter-tab-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
  color: var(--color-primary-text);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.filter-tab-indicator {
  position: absolute;
  bottom: 10rpx;
  width: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary-dark);
  transition: left 300ms cubic-bezier(.3, .7, .2, 1);
}

/* 页面给所有 scroll-view 铺了灰底，这里改回卡片白 */
.filter-body {
  background-color: var(--color-surface);
  /* 卡片最高到窗口底部留 32rpx：减去分组标签 84rpx 和按钮区 116rpx */
  max-height: calc(100vh - var(--filter-top, var(--search-area)) - 232rpx - var(--tab-bar-height));
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.filter-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm) 12rpx;
  padding: var(--space-md);
}

.filter-group {
  border-top: 1rpx solid var(--color-gray-normal);
}

.filter-group .filter-chip-row {
  padding-top: var(--space-sm);
}

.filter-group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-md) var(--space-md) 0;
  color: var(--color-black-light);
  font-size: 26rpx;
  font-weight: 600;
}

.filter-group-hint {
  color: var(--color-gray-max);
  font-size: 22rpx;
  font-weight: 400;
}

/* 选项胶囊：与外显校区行一致，未选灰描边，选中黄描边浅黄底 */
.filter-chip {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-gray-normal);
  border-radius: var(--radius-pill);
  color: var(--color-black-min);
  font-size: var(--font-size-chip);
  box-sizing: border-box;
}

.filter-chip.active {
  border-color: var(--color-primary);
  background-color: var(--color-primary-light);
  color: var(--color-primary-text);
  font-weight: 600;
}

.filter-actions {
  flex-shrink: 0;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md) var(--space-md);
  border-top: 1rpx solid var(--color-gray-normal);
}

/* 按钮样式见 public/wxss/button.wxss，这里只管两颗按钮的宽度分配 */
.filter-actions .form-button {
  /* 卡片内按钮比公共默认 88rpx 稍矮 */
  --form-button-height: 76rpx;
  flex: 1;
}

.filter-actions .reset-button {
  flex: 0 0 34%;
}

/* 寻找领养按钮 */
#find-adopt {
  position: fixed;
  bottom: 300rpx;
  right: 30rpx;
  z-index: 50;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;

  filter: drop-shadow(0 0 5rpx var(--color-gray-dark));
  transform: translateZ(0);
}

/* 返回首页 */
#back-to-firstpage {
  position: fixed;
  bottom: 200rpx;
  right: 30rpx;
  z-index: 50;

  filter: drop-shadow(0 0 5rpx var(--color-gray-dark));
  transform: translateZ(0);
}

#find-adopt .logo {
  width: 99rpx;
  height: 50rpx;
  display: block;
}

#find-adopt .count {
  font-size: 20rpx;
  padding: 1rpx 10rpx;
  background-color: var(--color-primary);
  border-radius: 5rpx;
  color: var(--color-black-light);
}

.adopt-filter-tip {
  position: fixed;
  top: var(--search-area);
  right: 20rpx;
  opacity: 1;

  transition: transform 1s, opacity 1s;
}

.adopt-filter-tip.hide {
  opacity: 0;
  transform: translateY(-25px);
}

.adopt-filter-tip .tri {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 10rpx 10rpx 10rpx;
  border-color: transparent transparent var(--color-black-transparent) transparent;

  position: absolute;
  right: 20rpx;
}

.adopt-filter-tip .content {
  width: 180rpx;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx;
  background-color: var(--color-black-transparent);
  color: var(--color-text-inverse);

  border-radius: 10rpx;
  
  position: absolute;
  right: 0;
  top: 10rpx;
}

.shake {
  /* 摇晃动画 */
  animation-name: upAnimation;
  animation-duration: 2s;
  animation-fill-mode: both;
  animation-iteration-count: 6;
  animation-delay: 2s;
}
@keyframes upAnimation {
  0% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  10% {
      transform: rotate(-12deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  20% {
      transform: rotate(12deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  28% {
      transform: rotate(-10deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  36% {
      transform: rotate(10deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  42% {
      transform: rotate(-8deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  48% {
      transform: rotate(8deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  52% {
      transform: rotate(-4deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  56% {
      transform: rotate(4deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  60% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  100% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }
}


