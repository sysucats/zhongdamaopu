@import "/pages/public/wxss/card.wxss";

/* pages/genealogy/detailCat/badgeDetail/badgeDetail.wxss */
page {
  background-color: var(--color-gray-light);
}

.bd-item {
  display: flex;
  flex-direction: row;
  margin: 10rpx 0;
  align-items: center;
  gap: var(--space-sm);
}

.badge-order {
  width: 30rpx;
  flex-shrink: 0;
  font-size: var(--font-size-caption);
  text-align: center;
}

.badge-img {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
}

.badge-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.badge-name {
  overflow-wrap: anywhere;
  font-size: 24rpx;
}

.badge-level {
  font-size: 22rpx;
}

.badge-desc {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
}

.badge-level-A .badge-name {
  color: var(--color-badge-A);
}

.badge-level-B .badge-name {
  color: var(--color-badge-B);
}

.badge-level-C .badge-name {
  color: var(--color-badge-C);
}

.user-info {
  width: 240rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.user-info.current-user {
  border-right: 10rpx solid var(--color-primary);
  padding-right: var(--space-sm);
}

.user-info-name{
  width: 100%;
  min-width: 0;
  font-size: var(--font-size-caption);
  color: var(--color-black-min);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.user-info-name-text {
  display: block;
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

.user-avatar {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border-radius: 100%;
  margin-right: 10rpx;
  display: inline-block;
}

.badge-count {
  flex-shrink: 0;
  font-size: var(--font-size-caption);
  text-align: center;
}

.user-info-time {
  font-size: var(--font-size-caption);
  color: var(--color-gray-dark);
  white-space: nowrap;
  text-align: right;
}
