/* pages/genealogy/detailCat/ratingDetail/ratingDetail.wxss */
@import "/pages/public/wxss/card.wxss";
@import "/pages/public/wxss/button.wxss";

page { background: var(--color-gray-light); }

.one-rating {
  display: flex;
  flex-direction: row;
  justify-content: space-evenly;
  align-items: center;
  margin-bottom: var(--space-md);
  font-size: var(--font-size-body);
}

.one-rating .title {
  width: 100rpx;
  text-align: right;

}

.stars {
  width: 300rpx;
  height: 60rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.one-star {
  width: 50rpx;
  height: 50rpx;
}

.one-star.gray {
  filter: grayscale(100%);
  opacity: 0.3;
}

.one-star image {
  width: 100%;
  height: 100%;
}

.score {
  width: 50rpx;
  text-align: center;
  color: var(--color-primary-text);
  font-weight: bold;
}

.rating-submit {
  margin-top: var(--space-md);
}
