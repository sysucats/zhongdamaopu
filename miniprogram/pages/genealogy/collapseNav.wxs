// 首页导航栏折叠：滚过阈值后，搜索栏按固定时长一次性收进导航栏；回到顶部附近再展开。
// 不跟手，不会停在半路：动画快慢与手指速度、滚动事件疏密无关，每次都一样顺。
// 全程在渲染层逐帧改样式，不走 setData。
// m 由页面 js 按胶囊位置算好，单位 px：
//   on/off 收起/展开阈值（scrollTop 超过 on 收起，低于 off 或触发到顶事件时展开，中间留缓冲避免来回切换）；
//   rise 纵向行程；eh/ch 展开/收起时搜索框高度；epl/cpl、epr/cpr 展开/收起时搜索行左、右内边距；
//   ps 轨迹参数：先收窄变矮（横向在 ps 前收完），再升进胶囊那一行，全程不碰胶囊、两端平滑起停（推导见 genealogy.js initNavMetrics）
var DURATION = 300; // 一次完整收起 / 展开的时长（ms）；中途反向时按剩余进度折算

function clamp(v) {
  return v < 0 ? 0 : (v > 1 ? 1 : v);
}

function now() {
  return getDate().getTime();
}

// p 为收起进度（0 展开，1 收起），随时间匀速推进；起停的缓动由下面两条曲线负责
function apply(m, p, ins) {
  // 横向 smoothstep，在 ps 收完；纵向 4p³ − 3p⁴。两者起步、到位时速度都为 0
  var t = p >= m.ps ? 1 : p / m.ps;
  var qx = t * t * (3 - 2 * t);
  var qy = p * p * p * (4 - 3 * p);
  var h = m.eh + (m.ch - m.eh) * qx;
  var pl = m.epl + (m.cpl - m.epl) * qx;
  var pr = m.epr + (m.cpr - m.epr) * qx;
  ins.selectComponent('#search').setStyle(
    'transform: translateY(' + (-m.rise * qy) + 'px); padding-left: ' + pl + 'px; padding-right: ' + pr + 'px; --search-h: ' + h + 'px;'
  );

  // 名字在搜索行升进胶囊那一行（进度 ps）之前淡出并略微上移
  var tp = clamp(p / m.ps);
  ins.selectComponent('.nav-title').setStyle('opacity: ' + (1 - tp) + '; transform: translateY(' + (-6 * tp) + 'px);');
}

// 从当前进度动画到 target；动画中途改了目标就地掉头
function animateTo(ins, state, target) {
  state.target = target;
  // 告诉页面搜索栏最终收起与否：筛选卡片、点卡片后的定位据此直接算位置，不必等动画或量位置
  ins.callMethod('onNavState', { collapsed: target === 1 });
  // 导航栏下沿投影（样式见 .nav-bar.collapsed）随目标切换，自带 transition
  var bar = ins.selectComponent('.nav-bar');
  if (target === 1) bar.addClass('collapsed');
  else bar.removeClass('collapsed');
  if (state.animating) return;
  state.animating = true;
  var last = now();
  var tick = function () {
    var t = now();
    var step = (t - last) / DURATION;
    last = t;
    var p = state.p || 0;
    p = state.target > p ? Math.min(state.target, p + step) : Math.max(state.target, p - step);
    state.p = p;
    apply(state.m, p, ins);
    if (p !== state.target) ins.requestAnimationFrame(tick);
    else state.animating = false;
  };
  ins.requestAnimationFrame(tick);
}

function onScroll(e, ins) {
  var m = e.currentTarget.dataset.m;
  if (!m || !m.rise) return;
  var state = ins.getState();
  state.m = m;
  var y = e.detail.scrollTop;
  if (state.target !== 1 && y > m.on) animateTo(ins, state, 1);
  else if (state.target === 1 && y < m.off) animateTo(ins, state, 0);
}

// 到顶兜底：快速甩回顶部时最后一次滚动事件可能还停在 off 之外，靠 scroll-view 的到顶事件展开
function onTop(e, ins) {
  var m = e.currentTarget.dataset.m;
  if (!m || !m.rise) return;
  var state = ins.getState();
  state.m = m;
  if (state.target === 1) animateTo(ins, state, 0);
}

// 列表重新加载（页面 data.navReset 的属性监听）：列表清空后回到顶部，但不一定有滚动事件，这里直接按顶部处理
function onReset(v, old, ins) {
  if (!old && old !== 0) return; // 首次渲染
  var state = ins.getState();
  if (state.target === 1 && state.m) animateTo(ins, state, 0);
}

module.exports = {
  onScroll: onScroll,
  onTop: onTop,
  onReset: onReset
};
