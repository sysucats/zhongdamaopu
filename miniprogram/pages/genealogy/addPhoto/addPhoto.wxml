<!-- 禁用页面滚动（地图选点打开时） -->
<page-meta page-style="{{pageMetaStyle}}"></page-meta>

<!-- 坐标格式化 WXS -->
<wxs module="fmt">
function fixed6(val) {
  if (val === undefined || val === null) return '--';
  return val.toFixed(6);
}
module.exports = {
  fixed6: fixed6
};
</wxs>

<view class="form-page">
  <view class="form-section" wx:if="{{!canUpload}}">
    <view class="form-state">暂时无法上传，请联系管理员 TAT...</view>
    <button class="form-button primary" bindtap="goBackIndex">返回首页</button>
  </view>
  <block wx:else>
    <view class="form-section" wx:if="{{!isAuth}}">
      <profile-prompt context="为「{{cat.name}}」添加照片" bind:edit="getUInfo" />
    </view>
    <block wx:else>
      <view class="form-section form-context">
        <image class="context-avatar" src="{{user.userInfo.avatarUrl || '/pages/public/images/system/user.png'}}" mode="aspectFill" />
        <view class="context-copy">
          <view>{{user.userInfo.nickName}}</view>
          <view class="field-hint">正在为「{{cat.name}}」添加照片</view>
        </view>
        <button class="profile-edit-button" bindtap="getUInfo" aria-label="修改个人信息"><text class="iconfont icon-edit"></text></button>
      </view>
      <view class="form-section" wx:if="{{!photos.length}}">
        <view class="image-upload" bindtap="chooseImg" aria-role="button" aria-label="选择照片">
          <text class="iconfont icon-photo-up upload-icon"></text>
          <view class="upload-label">选择照片</view>
        </view>
      </view>
      <view class="form-section">
        <view class="section-heading">
          <view class="section-title">拍摄位置</view>
          <button class="location-clear" wx:if="{{location}}" bindtap="clearLocation">清除</button>
        </view>
        <view class="form-actions">
          <button class="form-button compact location-button" bindtap="openMapPicker"><text class="iconfont icon-map-pin location-action-icon"></text><text>{{location ? '修改拍摄位置' : '选择拍摄位置'}}</text></button>
          <button class="form-button compact location-button" bindtap="autoLocate"><text class="iconfont icon-current-location location-action-icon"></text><text>自动定位</text></button>
        </view>
        <view class="field-hint" wx:if="{{location}}">已选位置：{{fmt.fixed6(location.latitude)}}, {{fmt.fixed6(location.longitude)}}</view>
      </view>
      <view class="form-section" hidden="{{!photos || photos.length < 2}}">
        <view class="section-title">统一设置</view>
        <view class="field-label">拍摄日期</view>
        <picker mode="date" fields="day" bindchange="setAllDate" start="{{birth_date || '2008-01-01'}}" end="{{now_date}}"><view class="field-picker">{{set_all.shooting_date || '选择拍摄日期'}}<view class="picker-arrow"></view></view></picker>
        <view class="field-label spaced-label">拍摄者（选填）</view>
        <input class="field-input" type="text" placeholder="默认为上传者" bindinput="setAllPher" value="{{set_all.pher}}" />
        <view class="field-hint">应用到所有照片</view>
      </view>
      <wxs module="isHEIC">
        module.exports.isHEIC = function (str) {
          return str.indexOf(".HEIC") != -1
        }
      </wxs>
      <view class="form-section" wx:for="{{photos}}" wx:key="path">
        <image class="image-preview photo-preview" src="{{item.file.path}}" mode="aspectFit" show-menu-by-longpress="1" />
        <view class="field-hint" wx:if="{{isHEIC.isHEIC(item.file.path)}}">* 照片格式为.HEIC，可能会显示不出来</view>
        <view class="field-label field-required">拍摄日期</view>
        <picker mode="date" fields="day" bindchange="pickDate" start="{{birth_date || '2008-01-01'}}" end="{{now_date}}" data-index="{{index}}"><view class="field-picker">{{item.shooting_date || '选择拍摄日期'}}<view class="picker-arrow"></view></view></picker>
        <view class="field-label spaced-label">拍摄者（选填）</view>
        <input class="field-input" type="text" placeholder="默认为上传者" bindinput="inputPher" data-index="{{index}}" value="{{item.pher}}" />
        <view class="form-actions photo-actions">
          <button class="form-button" bindtap="removeOne" data-index="{{index}}" disabled="{{uploading}}">移除</button>
          <button class="form-button primary" bindtap="uploadSingleClick" data-index="{{index}}" disabled="{{!item.shooting_date || !item.file.path || uploading}}">确定上传</button>
        </view>
      </view>
      <view class="save-bar" wx:if="{{photos.length && !mapPickerVisible}}">
        <button class="form-button photo-add-button" bindtap="chooseImg" disabled="{{uploading}}" aria-label="添加照片"><text class="iconfont icon-photo-plus"></text></button>
        <button class="form-button primary save-button" bindtap="uploadAllClick" disabled="{{uploading}}" loading="{{uploading}}">全部上传</button>
      </view>
    </block>
  </block>
</view>

<!-- 地图选点浮层 -->
<map
  wx:if="{{mapPickerVisible}}"
  id="photoMapPicker"
  class="picker-map"
  latitude="{{mapPickerInitLat}}"
  longitude="{{mapPickerInitLng}}"
  scale="{{mapPickerScale}}"
  min-scale="3"
  max-scale="20"
  enable-zoom="{{true}}"
  enable-scroll="{{true}}"
  bindregionchange="onMapRegionChange"
  show-location="{{false}}"
>
  <cover-view class="picker-crosshair">
    <cover-view class="crosshair-v"></cover-view>
    <cover-view class="crosshair-h"></cover-view>
  </cover-view>
  <!-- 缩放按钮 -->
  <cover-view class="picker-zoom-bar">
    <cover-view class="zoom-btn" bindtap="zoomMapIn">+</cover-view>
    <cover-view class="zoom-divider"></cover-view>
    <cover-view class="zoom-btn" bindtap="zoomMapOut">−</cover-view>
  </cover-view>
  <cover-view class="picker-bottom-bar">
    <cover-view class="picker-title">选择拍摄位置</cover-view>
    <cover-view class="picker-hint">拖动地图，将准星对准拍摄位置</cover-view>
    <cover-view class="picker-actions">
      <cover-view class="picker-btn" bindtap="cancelMapPicker">取消</cover-view>
      <cover-view class="picker-btn primary" bindtap="confirmMapPicker">{{mapPickerConfirming ? '确认中…' : '确定位置'}}</cover-view>
    </cover-view>
  </cover-view>
</map>

<!-- 个人信息修改组件 -->
<modifyUserInfo show="{{showEdit}}" bind:close="closeEdit"></modifyUserInfo>