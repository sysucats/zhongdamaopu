@import "/pages/public/wxss/form.wxss";

.photo-actions {
  margin-top: var(--space-md);
}

.photo-preview {
  height: 440rpx;
}

.location-clear {
  margin: -12rpx -12rpx -12rpx 0;
  padding: 12rpx;
  background: transparent;
  color: var(--color-gray-max);
  font-size: 24rpx;
  line-height: 1.5;
  text-decoration: underline;
}

.location-clear::after {
  border: none;
}

.form-button.location-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  height: 64rpx;
  min-height: 44px;
  line-height: 1.4;
}

.location-action-icon {
  display: block;
  line-height: 1;
  font-size: 30rpx;
  color: inherit;
}

.photo-add-button {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border-radius: 50%;
  line-height: 1;
}

.photo-add-button .iconfont {
  font-size: 36rpx;
  color: inherit;
}

/* ========== 地图选点浮层 ========== */
.picker-map {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

/* 十字准星 */
.picker-crosshair {
  position: fixed;
  top: 50%;
  left: 50%;
  margin-left: -30rpx;
  margin-top: -30rpx;
  width: 60rpx;
  height: 60rpx;
  pointer-events: none;
}

.crosshair-v {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  background: var(--color-primary);
  margin-left: -2rpx;
  border-radius: 2rpx;
}

.crosshair-h {
  position: absolute;
  top: 50%;
  left: 0;
  height: 4rpx;
  width: 100%;
  background: var(--color-primary);
  margin-top: -2rpx;
  border-radius: 2rpx;
}

/* 缩放按钮 */
.picker-zoom-bar {
  position: fixed;
  right: var(--space-md);
  top: 50%;
  margin-top: -80rpx;
  width: 88rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.zoom-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 300;
  color: var(--color-black-min);
  background: transparent;
}

.zoom-divider {
  width: 52rpx;
  height: 1rpx;
  background: var(--color-gray-normal);
  margin: 0 auto;
}

/* 底部操作栏 */
.picker-bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  width: 100%;
  padding: var(--space-md) var(--space-lg)
    calc(var(--space-md) + env(safe-area-inset-bottom));
  border-top-left-radius: var(--radius-xl);
  border-top-right-radius: var(--radius-xl);
  background: #fff;
}

.picker-title {
  color: var(--color-black-light);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.picker-hint {
  margin-top: var(--space-xs);
  color: var(--color-gray-max);
  font-size: 24rpx;
  line-height: 36rpx;
}

.picker-actions {
  display: flex;
  margin-top: var(--space-md);
}

.picker-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--color-gray-normal);
  color: var(--color-black-light);
  font-size: 29rpx;
  line-height: 88rpx;
  text-align: center;
}

.picker-btn + .picker-btn {
  margin-left: var(--space-sm);
}

.picker-btn.primary {
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
}
