@import "/pages/public/wxss/form.wxss";

/* 状态卡片 */
.status-card {
  padding: 40rpx 30rpx;
  text-align: center;
}

.status-card.approved {
  background: var(--color-status-success-bg);
  border: 2rpx solid var(--color-status-success-line);
}

.status-card.pending {
  background: var(--color-status-pending-bg);
  border: 2rpx solid var(--color-primary);
}

.status-card.rejected {
  background: var(--color-status-error-bg);
  border: 2rpx solid var(--color-status-error-line);
}

.status-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.status-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.status-detail {
  font-size: 26rpx;
  color: var(--color-black-min);
  margin-top: 8rpx;
  line-height: 1.6;
}

.status-hint {
  font-size: 26rpx;
  color: var(--color-black-min);
  margin-top: 20rpx;
  line-height: 1.6;
}

.reapply-btn {
  margin-top: 30rpx;
}

/* 申请条件 */
.req-desc {
  font-size: 26rpx;
  color: var(--color-black-min);
  margin-bottom: 12rpx;
}

.req-stats {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.req-status.unmet {
  font-size: 24rpx;
  color: var(--color-red);
  margin-top: 8rpx;
}

.req-status.met {
  font-size: 24rpx;
  color: var(--color-green);
  margin-top: 8rpx;
}

/* 自动通过规则 */
.auto-pass-box.active {
  background: var(--color-status-success-bg);
}

.auto-pass-desc {
  font-size: 26rpx;
  color: var(--color-black-min);
  margin-top: 8rpx;
  line-height: 1.6;
}

.application-note {
  margin-top: var(--space-md);
  text-align: center;
}
