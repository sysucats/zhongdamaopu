<!--pages/genealogy/commentBoard.wxml-->

<scroll-view id="comment-list" scroll-y="true" bindscrolltolower='loadMoreComment' enable-back-to-top="true" bindscroll="bindCommentScroll" enable-flex="1">
  <!-- 猫猫名称 -->
  <view class='big-header'>
    <image class='avatar' mode='aspectFill' src='{{cat.avatar.photo_compressed || cat.avatar.photo_id || "/pages/public/images/app_logo.png"}}'></image>
    <view class='name-and-count'>
      <view class='name'>{{cat.name}}的便利贴墙</view>
      <view class='count'>共{{comment_count}}张便利贴</view>
    </view>
  </view>

  <!-- 评论列表 -->

  <comment-paper class="comment" wx:for="{{comments}}" wx:key="_id" item="{{item}}" mask-pending="{{true}}" can-delete="{{is_manager || item.user_openid === user.openid}}" bind:like="likeComment" data-item-id="{{item._id}}" bind:delete="deleteComment" data-item="{{item}}" data-index="{{index}}" />

  <!-- 输入框占位 -->
  <view class="input-block-ph"></view>
</scroll-view>

<!-- 悬浮的猫猫名称栏 -->
<view class='big-header fix' hidden="{{!show_fix_header}}">
  <image class='avatar' mode='aspectFill' src='{{cat.avatar.photo_compressed || cat.avatar.photo_id}}'></image>
  <view class='name-and-count'>
    <view class='name'>{{cat.name}}的便利贴墙</view>
    <view class='count'>共{{comments.length}}张便利贴</view>
  </view>
</view>


<view id="input-block" style="margin-bottom: {{keyboard_height}}px;" class="{{keyboard_height>0 ? 'active': ''}}" wx:if="{{canComment}}">
  <profile-prompt wx:if="{{!isAuth}}" context="为「{{cat.name}}」写便利贴" bind:edit="getUInfo" />
  <block wx:else>
    <view class="comment-composer">
      <button class="comment-profile" bindtap="getUInfo" aria-label="修改个人信息">
        <image class="comment-profile-avatar" src="{{user.userInfo.avatarUrl || '/pages/public/images/system/user.png'}}" mode="aspectFill" />
        <text class="iconfont icon-edit comment-profile-mark"></text>
      </button>
      <textarea id="comment-input" value="{{comment_input}}" auto-height="{{true}}" show-confirm-bar="{{false}}" maxlength="300" placeholder="{{text_cfg.comment_board.comment_tip}}" adjust-position="{{false}}" bindfocus="commentFocus" bindblur="commentBlur" bindinput="commentInput"></textarea>
    </view>
    <view class="bottom-line">
      <view class="color-label">颜色</view>
      <view class="composer-actions">
        <view class="input-colors">
          <button class="color-choice" wx:for="{{paper_colors}}" wx:key="*this" bindtap="selectPaperColor" data-index="{{index}}" aria-label="{{paper_color_names[index]}}">
            <view class="input-color {{item}} {{paper_color_select == index ? 'selected' : ''}}"></view>
          </button>
        </view>
        <button class="send-btn" bindtap="sendComment">发送</button>
      </view>
    </view>
  </block>
  <!-- 解决iOS UI兼容性 -->
  <view wx:if="{{keyboard_height == 0}}" id="input-block-bottom"></view>
</view>
<view wx:else class="comment-input-closed"><text>便利贴功能已被关闭... QAQ</text></view>

<achievement-unlock id="achievement-unlock" />

<modifyUserInfo show="{{showEdit}}" bind:close="closeEdit" bind:userInfoUpdated="onUserInfoUpdated" />
