@import "/pages/public/wxss/iconfont.wxss";
@import "/pages/public/wxss/button.wxss";

/* 便利贴墙 */
page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background-color: var(--color-gray-light);
}

/* 下面开始悬浮标题 */
.big-header {
  background-color: white;
  display: flex;
  align-items: center;
  border: solid var(--color-gray-light);
  border-width: 1rpx 0;
  position: sticky;
  top: 0;
  position: -webkit-sticky;
  z-index: 1;
  width: 100%;
}

.big-header .avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 70rpx;
  margin: 30rpx;
}
.big-header .name-and-count {
  display: inline-block;
  flex-grow: 1;
}
.big-header .name-and-count .name {
  height: 36rpx;
  line-height: 36rpx;
  font-size: 36rpx;
  font-weight: 450;
  margin: 30rpx 0 10rpx 0;
  width: 380rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.big-header .name-and-count .count {
  height: 28rpx;
  line-height: 28rpx;
  font-size: 28rpx;
  color: var(--color-black-min);
  font-weight: 400;
  margin-bottom: 30rpx;
}

#comment-list {
  width: 750rpx;
  flex: 1;
  min-height: 0;
  height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.comment {
  width: 600rpx;
  margin: 30rpx 10rpx;
  box-sizing: border-box;
}

.big-header.fix {
  position: absolute;
  left: 0;
  top: 0;
}

#input-block,
.comment-input-closed {
  width: 750rpx;
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  background-color: white;
  box-sizing: border-box;
  border-top: 1rpx solid var(--color-gray-light);
}

.comment-input-closed text {
  width: 750rpx;
  text-align: center;
  color: var(--color-gray-dark);
}

#input-block-bottom {
  width: 750rpx;
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

#input-block.active {
  padding-bottom: 10rpx;
}

#input-block textarea {
  flex: 1;
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  min-height: 88rpx;

  background-color: var(--color-white-dark);
  color: var(--color-black-light);
  padding: 18rpx 20rpx;
  border-radius: 10rpx;

  font-size: 30rpx;
  line-height: 30rpx;
}

#input-block .bottom-line {
  display: grid;
  grid-template-columns: max(88rpx, 44px) minmax(0, 1fr);
  align-items: center;
  gap: var(--space-sm);
  width: 100%;
  margin-top: var(--space-xs);
  color: var(--color-black-min);
  font-size: 24rpx;
}

.color-label {
  text-align: center;
}

.composer-actions,
.input-colors {
  display: flex;
  align-items: center;
}

.composer-actions {
  justify-content: space-between;
  gap: var(--space-xs);
}

.color-choice {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  background: transparent;
}

.color-choice::after {
  border: none;
}

.input-color {
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid var(--color-gray-dark);
  border-radius: 50%;
  background: var(--color-comment-paper-white);
}

.input-color.yellow {
  background: var(--color-comment-paper-yellow);
}

.input-color.green {
  background: var(--color-comment-paper-green);
}

.input-color.pink {
  background: var(--color-comment-paper-pink);
}

.input-color.selected {
  border: 3rpx solid var(--color-primary);
}

#input-block .send-btn {
  flex-shrink: 0;
}

.comment-composer {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  width: 100%;
}

.comment-profile {
  position: relative;
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.comment-profile::after {
  border: none;
}

.comment-profile-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.comment-profile-mark {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: var(--color-gray-normal);
  color: var(--color-black-min);
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
