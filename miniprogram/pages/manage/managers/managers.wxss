@import "/pages/public/wxss/formControls.wxss";
@import "../adminPage.wxss";
@import "/pages/public/wxss/review.wxss";

page {
  background: var(--color-gray-light);
}

.managers-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  padding: var(--space-md) var(--space-lg) 0;
}

.admin-segments,
.filter-section,
.old-invite {
  flex-shrink: 0;
}

.pending-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 32rpx;
  height: 32rpx;
  margin-left: var(--space-xs);
  padding: 0 var(--space-xs);
  border-radius: var(--radius-pill);
  background: var(--color-red);
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  vertical-align: middle;
}

.management-panel {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.management-list {
  width: calc(100% + var(--space-lg) + var(--space-lg));
  margin-left: calc(0rpx - var(--space-lg));
  flex: 1;
  height: 0;
  min-height: 0;
}

.list-content {
  padding: 0 var(--space-lg) calc(var(--space-md) + env(safe-area-inset-bottom));
}

.search-field {
  position: relative;
}

.search-input {
  padding-left: var(--space-section);
}

.search-icon {
  position: absolute;
  top: 50%;
  left: var(--space-sm);
  color: var(--color-gray-max);
  font-size: 32rpx;
  transform: translateY(-50%);
}

.user-filters {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.filter-choice {
  display: flex;
  align-items: center;
  color: var(--color-black-min);
  font-size: 24rpx;
}

.old-invite {
  margin-bottom: var(--space-md);
  color: var(--color-gray-max);
  font-size: 24rpx;
  text-align: center;
  text-decoration: underline;
}

.user-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-lg);
  background: #fff;
}

.user-edit-target {
  display: flex;
  flex: 1;
  align-items: center;
  gap: var(--space-sm);
  min-width: 0;
  min-height: 88rpx;
}

.user-edit-hover {
  opacity: 0.7;
}

.user-name {
  overflow: hidden;
  color: var(--color-black-light);
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-summary {
  overflow: hidden;
  color: var(--color-gray-max);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-map-access {
  flex-shrink: 0;
  text-align: center;
}

.map-access-label {
  margin-bottom: var(--space-xxs);
  color: var(--color-gray-max);
  font-size: 22rpx;
}

.user-editor {
  display: flex;
  flex-direction: column;
  max-height: calc(80vh - max(20rpx, env(safe-area-inset-bottom)));
}

.user-editor-body {
  min-height: 0;
  overflow-y: auto;
  margin: 0 -20rpx;
  padding: 0 calc(20rpx + var(--space-xs));
}

.editor-user {
  margin: var(--space-sm) var(--space-md) var(--space-md);
}

.manager-option {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 88rpx;
  margin-bottom: var(--space-xs);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-md);
}

.manager-option .status-title,
.manager-option .field-hint {
  line-height: 1.4;
}

.manager-option:last-child {
  margin-bottom: 0;
}

.manager-option.selected {
  background: var(--color-primary-bg);
}

.role-choices {
  margin-top: 0;
}

.role-choice {
  flex: 1;
  min-width: 140rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  text-align: center;
}

.role-choice::after {
  border: none;
}

.application-stats {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin: var(--space-md) 0;
  color: var(--color-black-min);
  font-size: 25rpx;
}

.attention-tip {
  color: var(--color-red);
}

.management-empty,
.management-loading {
  padding: var(--space-xl) var(--space-md);
  color: var(--color-gray-max);
  font-size: 27rpx;
  text-align: center;
}
