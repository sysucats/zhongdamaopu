@import "/pages/public/wxss/formControls.wxss";

page { background: var(--color-gray-light); }
.image-blocks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-sm); margin-bottom: var(--space-md); }
.image-block { text-align: center; min-width: 0; }
.image-block .title { margin-bottom: var(--space-xs); font-size: var(--font-size-caption); font-weight: 500; color: var(--color-black-min); }
.image-block image, .no-image { box-sizing: border-box; width: 100%; height: 200rpx; border: 1rpx solid var(--color-gray); border-radius: var(--radius-lg); }
.no-image { display: flex; align-items: center; justify-content: center; color: var(--color-gray-max); }
.status-info { color: var(--color-gray-max); font-size: var(--font-size-caption); line-height: 1.6; }
.buttons { display: flex; gap: var(--space-sm); margin: var(--space-md) 0; }
.buttons .form-button { flex: 1; width: 0; min-width: 0; }
.info-block { margin: var(--space-lg) 0; color: var(--color-gray-max); font-size: var(--font-size-caption); line-height: 1.7; overflow-wrap: anywhere; }
.info-block view + view { margin-top: var(--space-xs); }
.list-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-md); }
.select-all { display: flex; align-items: center; font-size: var(--font-size-body); }
.selected-count { font-size: var(--font-size-caption); color: var(--color-gray-max); }
.photos-container { max-height: 600rpx; overflow-y: auto; }
.photo-item { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-sm) 0; border-bottom: 1rpx solid var(--color-gray-normal); }
.photo-item:last-child { border-bottom: none; }
.photo-checkbox { flex-shrink: 0; }
.photo-preview { width: 96rpx; height: 96rpx; flex-shrink: 0; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-gray-light); }
.photo-preview image { width: 100%; height: 100%; }
.not-show-img { display: flex; align-items: center; justify-content: center; height: 100%; font-size: var(--font-size-caption); color: var(--color-gray-max); }
.photo-info { flex: 1; min-width: 0; font-size: var(--font-size-caption); color: var(--color-gray-max); line-height: 1.6; }
.photo-info view { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.photo-actions { display: flex; flex-direction: column; gap: var(--space-xs); flex-shrink: 0; }
