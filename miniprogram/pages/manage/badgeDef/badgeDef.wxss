/* pages/manage/badgeDef/badgeDef.wxss */
@import "../adminPage.wxss";
page {
  background-color: var(--color-gray-light);
}

.badge-manage {
  padding: 24rpx var(--space-lg) 60rpx;
}
.catalog-error {
  margin-bottom: 20rpx;
  color: var(--color-red);
  font-size: 24rpx;
}
.catalog-section {
  margin-bottom: 32rpx;
}
.catalog-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  gap: 16rpx;
}
.catalog-title {
  color: var(--color-black-light);
  font-size: 32rpx;
  font-weight: 600;
}
.catalog-count {
  margin-left: 16rpx;
  color: var(--color-gray-max);
  font-size: 22rpx;
  font-weight: 400;
}
.catalog-main-heading {
  margin-top: 36rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-gray-normal);
}
.series-heading {
  margin-top: 16rpx;
}
.series-heading .catalog-title {
  font-size: 30rpx;
}
.catalog-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.catalog-tile {
  min-width: 0;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  background: #fff;
  overflow: hidden;
  text-align: center;
}
.material-grid {
  margin-top: 8rpx;
}
.material-tile {
  padding: 16rpx;
}
.material-add {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  min-height: 172rpx;
}
.material-add-icon {
  color: var(--color-gray-max);
  font-size: 52rpx;
  line-height: 1;
}
.material-add-label {
  color: var(--color-gray-max);
  font-size: 24rpx;
  line-height: 32rpx;
}
.new-achievement {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding-left: 16rpx;
  color: var(--color-primary-text);
  font-size: 25rpx;
}
.new-achievement .iconfont {
  font-size: 30rpx;
}
.material-preview {
  display: block;
  width: 100%;
  height: 92rpx;
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
}
.metric-group {
  margin-top: 12rpx;
}
.metric-heading {
  min-height: 64rpx;
  margin-bottom: 8rpx;
}
.metric-title {
  color: var(--color-black-light);
  font-size: 25rpx;
  font-weight: 500;
}
.badge-tile {
  padding: 18rpx 12rpx 20rpx;
}
.badge-preview {
  display: block;
  width: 136rpx;
  max-width: 100%;
  height: 136rpx;
  margin: 0 auto 14rpx;
}
.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-gray-normal);
  color: var(--color-gray-max);
  font-size: 21rpx;
}
.tile-name {
  color: var(--color-black-light);
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 500;
  overflow-wrap: break-word;
}
.tile-condition {
  margin-top: 8rpx;
  min-height: 30rpx;
  color: var(--color-gray-max);
  font-size: 23rpx;
  line-height: 30rpx;
}
.tile-status {
  margin-top: 12rpx;
  color: var(--color-gray-max);
  font-size: var(--font-size-tag);
  line-height: 30rpx;
}
.tile-status.is-draft {
  color: var(--color-status-pending-text);
}
.tile-holders {
  margin-top: 4rpx;
  color: var(--color-gray-max);
  font-size: 20rpx;
  line-height: 28rpx;
}
.tile-pressed {
  opacity: 0.65;
}
.catalog-empty {
  padding: 48rpx 16rpx;
  text-align: center;
  color: var(--color-gray-max);
  font-size: 25rpx;
}

.code-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 24rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  color: var(--color-black-min);
  font-size: 26rpx;
}
.entry-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--color-gray-max);
  border-bottom: 2rpx solid var(--color-gray-max);
  transform: rotate(-45deg);
}
.cat-description {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 60rpx;
}
