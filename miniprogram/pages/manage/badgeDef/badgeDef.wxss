/* pages/manage/badgeDef/badgeDef.wxss */
@import "../adminPage.wxss";
@import "/pages/public/wxss/formControls.wxss";
.prepare-existing { margin-bottom: var(--space-md); }
page {
  background-color: var(--color-gray-light);
}

.badge-manage {
  padding: 24rpx var(--space-lg) 60rpx;
}
.catalog-error {
  margin-bottom: 20rpx;
  color: var(--color-red);
  font-size: 24rpx;
}
.catalog-section {
  margin-bottom: 32rpx;
}
.catalog-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  gap: 16rpx;
}
.catalog-heading .section-title {
  margin-bottom: 0;
}
.catalog-count {
  margin-left: 16rpx;
  color: var(--color-gray-max);
  font-size: 22rpx;
  font-weight: 400;
}
.catalog-main-heading {
  margin-top: 36rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-gray-normal);
}
.series-heading {
  margin-top: 16rpx;
}
.catalog-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.catalog-tile {
  min-width: 0;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  background: #fff;
  overflow: hidden;
  text-align: center;
}
.material-grid {
  margin-top: 8rpx;
}
.material-tile {
  padding: 16rpx;
}
.material-add {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  min-height: 172rpx;
}
.material-add-icon {
  color: var(--color-gray-max);
  font-size: 52rpx;
  line-height: 1;
}
.material-add-label {
  color: var(--color-gray-max);
  font-size: 24rpx;
  line-height: 32rpx;
}
.new-achievement {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding-left: 16rpx;
  color: var(--color-primary-text);
  font-size: 25rpx;
}
.new-achievement .iconfont {
  font-size: 30rpx;
}
.material-preview {
  display: block;
  width: 100%;
  height: 92rpx;
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
}
.metric-group {
  margin-top: 12rpx;
}
.metric-heading {
  min-height: 64rpx;
  margin-bottom: 8rpx;
}

.badge-tile {
  padding: 18rpx 12rpx 20rpx;
}
.badge-preview {
  display: block;
  width: 136rpx;
  max-width: 100%;
  height: 136rpx;
  margin: 0 auto 14rpx;
}
.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-gray-normal);
  color: var(--color-gray-max);
  font-size: 21rpx;
}
.tile-name {
  color: var(--color-black-light);
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 500;
  overflow-wrap: break-word;
}
.tile-condition {
  margin-top: 8rpx;
  min-height: 30rpx;
  color: var(--color-gray-max);
  font-size: 23rpx;
  line-height: 30rpx;
}
.tile-status {
  margin-top: 12rpx;
  color: var(--color-gray-max);
  font-size: var(--font-size-tag);
  line-height: 30rpx;
}
.tile-status.is-draft {
  color: var(--color-status-pending-text);
}
.tile-holders {
  margin-top: 4rpx;
  color: var(--color-gray-max);
  font-size: 20rpx;
  line-height: 28rpx;
}
.tile-pressed {
  opacity: 0.65;
}
.catalog-empty {
  padding: 48rpx 16rpx;
  text-align: center;
  color: var(--color-gray-max);
  font-size: 25rpx;
}

.code-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 24rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  color: var(--color-black-min);
  font-size: 26rpx;
}
.entry-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--color-gray-max);
  border-bottom: 2rpx solid var(--color-gray-max);
  transform: rotate(-45deg);
}
.cat-description {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 60rpx;
}

.common-settings {
  margin-top: var(--space-lg);
}
.thickness-setting {
  margin-top: var(--space-sm);
}
.thickness-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}
.thickness-value {
  color: var(--color-black-light);
  font-size: var(--font-size-body);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.thickness-unit {
  margin-left: 6rpx;
  font-size: var(--font-size-caption);
  font-weight: 400;
  color: var(--color-gray-max);
}
/* 整个控件（包括刻度行）共用展示轨道的实测坐标；原生 slider 保留无障碍操作。 */
.thickness-control {
  position: relative;
  height: 44px;
  margin-top: var(--space-xs);
}
.thickness-appearance {
  position: absolute;
  top: 0;
  right: 17px;
  bottom: 0;
  left: 17px;
  pointer-events: none;
}
.thickness-track {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 8px;
  transform: translateY(-50%);
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: var(--color-gray);
}
.thickness-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}
.thickness-thumb {
  position: absolute;
  top: 50%;
  width: 32px;
  height: 24px;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 14px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.62));
  -webkit-backdrop-filter: blur(4px) saturate(1.15);
  backdrop-filter: blur(4px) saturate(1.15);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8), 0 1px 4px rgba(0, 0, 0, 0.12);
  transform: translate(-50%, -50%);
}
.thickness-tick {
  position: absolute;
  top: 38px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--color-gray-dark);
  transform: translateX(-50%);
}
.thickness-slider {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 44px;
  margin: 0;
  opacity: 0;
  pointer-events: none;
}
.thickness-limits {
  display: flex;
  justify-content: space-between;
  margin-top: var(--space-xs);
  color: var(--color-gray-max);
  font-size: var(--font-size-caption);
  line-height: 1.5;
}
.thickness-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}
.thickness-actions .thickness-save {
  margin-left: auto;
}
.thickness-setting.is-saving .thickness-appearance {
  opacity: 0.45;
}
.tile-asset-status { margin-top: 8rpx; color: var(--color-gray-max); font-size: 20rpx; line-height: 1.5; }
.tile-asset-status.is-error, .tile-asset-error { color: var(--color-red); }
.tile-asset-error { font-size: 20rpx; line-height: 1.5; overflow-wrap: anywhere; }

.thickness-preview { display: flex; justify-content: center; margin-top: var(--space-md); }
