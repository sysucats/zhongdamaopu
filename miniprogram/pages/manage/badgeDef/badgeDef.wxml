<!--pages/manage/badgeDef/badgeDef.wxml-->
<block wx:if="{{auth}}">
  <view class="badge-manage">
    <view class="admin-segments">
      <view class="admin-segment {{activeTab === 'cat' ? 'active' : ''}}" data-tab="cat" bindtap="switchTab">猫猫徽章</view>
      <view class="admin-segment {{activeTab === 'user' ? 'active' : ''}}" data-tab="user" bindtap="switchTab">用户徽章</view>
    </view>
    <block wx:if="{{activeTab === 'cat'}}">
      <view class="catalog-heading">
        <view class="catalog-title">猫猫徽章<text class="catalog-count">{{badgeDefs.length}} 种</text></view>
        <view class="new-achievement" wx:if="{{canEdit}}" bindtap="onEdit" hover-class="tile-pressed" aria-role="button" aria-label="添加猫猫徽章">
          <text class="iconfont icon-circle-plus"></text><text>添加徽章</text>
        </view>
      </view>
      <view class="code-entry" bindtap="onBadgeCode" hover-class="tile-pressed" aria-role="button" aria-label="徽章兑换码管理">
        <text>兑换码管理</text><view class="entry-arrow"></view>
      </view>
      <view class="catalog-error" wx:if="{{catError}}" bindtap="loadBadgeDefs">{{catError}} · 点击重试</view>
      <view class="catalog-empty" wx:if="{{catLoading && !badgeDefs.length}}">加载中…</view>
      <view class="catalog-empty" wx:elif="{{!catLoading && !catError && !badgeDefs.length}}">暂无猫猫徽章</view>
      <view class="catalog-section" wx:for="{{catGroups}}" wx:for-item="group" wx:key="level">
        <view class="catalog-heading metric-heading">
          <view class="metric-title">{{group.level}} 级<text class="catalog-count">{{group.items.length}} 种</text></view>
        </view>
        <view class="catalog-grid">
          <view class="catalog-tile badge-tile" wx:for="{{group.items}}" wx:for-item="badge" wx:key="_id" bindtap="onEdit" data-id="{{badge._id}}" hover-class="tile-pressed" aria-role="button" aria-label="编辑{{badge.name}}徽章">
            <image class="badge-preview" wx:if="{{badge.img}}" src="{{badge.img}}" mode="aspectFit" />
            <view class="badge-preview image-placeholder" wx:else>待上传</view>
            <view class="tile-name">{{badge.name}}</view>
            <view class="tile-condition cat-description">{{badge.desc}}</view>
            <view class="tile-holders">现存 {{badge.count}} 枚</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="catalog-error" wx:if="{{catalogError}}">{{catalogError}}</view>

      <view class="catalog-section">
        <view class="catalog-heading">
          <view class="catalog-title">材质库<text class="catalog-count">{{materials.length}} 种</text></view>
        </view>
        <view class="catalog-grid material-grid">
          <view class="catalog-tile material-tile" wx:for="{{materials}}" wx:key="key" bindtap="editMaterial" data-key="{{item.key}}" hover-class="tile-pressed" aria-role="button" aria-label="编辑{{item.name}}材质">
            <image class="material-preview" src="{{item.preview}}" mode="aspectFill" wx:if="{{item.preview}}" />
            <view class="material-preview image-placeholder" wx:else>待上传</view>
            <view class="tile-name">{{item.name}}</view>
          </view>
          <view class="catalog-tile material-tile material-add" bindtap="editMaterial" hover-class="tile-pressed" aria-role="button" aria-label="新增材质">
            <text class="iconfont icon-circle-plus material-add-icon"></text>
            <text class="material-add-label">添加材质</text>
          </view>
        </view>
      </view>

      <view class="catalog-heading catalog-main-heading">
        <view class="catalog-title">用户徽章</view>
        <view class="new-achievement" bindtap="addUserAchievement" hover-class="tile-pressed" aria-role="button" aria-label="添加成就">
          <text class="iconfont icon-circle-plus"></text>
          <text>添加成就</text>
        </view>
      </view>
      <view class="catalog-empty" wx:if="{{!userSeries.length && !catalogError}}">暂无用户徽章</view>
      <view class="catalog-section" wx:for="{{userSeries}}" wx:for-item="series" wx:key="name">
        <view class="catalog-heading series-heading">
          <view class="catalog-title">{{series.name}}<text class="catalog-count">{{series.count}} 枚</text></view>
        </view>
        <view class="metric-group" wx:for="{{series.groups}}" wx:for-item="group" wx:key="metric">
          <view class="catalog-heading metric-heading">
            <view class="metric-title">{{group.name}}</view>
          </view>
          <view class="catalog-grid">
            <view class="catalog-tile badge-tile" wx:for="{{group.items}}" wx:for-item="badge" wx:key="key" bindtap="editUserBadge" data-key="{{badge.key}}" hover-class="tile-pressed" aria-role="button" aria-label="编辑{{badge.name}}">
              <image class="badge-preview" src="{{badge.preview}}" mode="aspectFit" wx:if="{{badge.preview}}" />
              <view class="badge-preview image-placeholder" wx:else>待上传</view>
              <view class="tile-name">{{badge.name}}</view>
              <view class="tile-condition">{{badge.description || badge.thresholdText}}</view>
              <view class="tile-status {{badge.status === 'draft' ? 'is-draft' : ''}}">{{badge.statusText}}</view>
              <view class="tile-holders">{{badge.holders}} 人获得{{badge.needsUpload ? ' · 待上传' : ''}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</block>

<!-- 未授权提示 -->
<no-auth wx:else tip-text="{{tipText}}"></no-auth>
