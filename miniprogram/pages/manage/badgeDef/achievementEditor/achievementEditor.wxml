<block wx:if="{{auth}}">
  <view class="form-state" wx:if="{{loading}}">加载中…</view>
  <view class="form-state" wx:elif="{{loadError}}">
    <view>{{loadError}}</view>
    <button class="form-button retry-button" bindtap="retryLoad">重新加载</button>
  </view>
  <view class="form-page" wx:else>
    <view class="form-section">
      <view class="section-title">{{mode === 'material' ? '基本信息' : '成就'}}</view>
      <view class="field-label field-required">{{mode === 'material' ? '材质名称' : '成就名称'}}</view>
      <input class="field-input" value="{{form.name}}" maxlength="20" placeholder="{{mode === 'material' ? '例如：翡翠' : '例如：镜头收藏家'}}" data-field="name" bindinput="onInput" aria-label="名称" />
      <block wx:if="{{mode !== 'material'}}">
        <view class="field-label spaced-label">成就说明（选填）</view>
        <textarea class="description-input" value="{{form.description}}" maxlength="100" placeholder="{{ruleDescription}}" data-field="description" bindinput="onInput" aria-label="成就说明" />
      </block>
    </view>

    <block wx:if="{{mode === 'material'}}">
      <view class="form-section">
        <view class="section-title field-required">材质图片</view>
        <view class="image-upload" data-field="image" bindtap="chooseImage" aria-role="button" aria-label="{{form.image ? '更换材质图片' : '上传材质图片'}}">
          <image wx:if="{{previews.image}}" class="material-image" src="{{previews.image}}" mode="aspectFill" />
          <text wx:else class="iconfont icon-photo-up upload-icon"></text>
          <view class="upload-label">{{form.image ? '更换图片' : '上传材质 PNG'}}</view>
        </view>
        <view class="field-hint">PNG，最大 5 MB，宽高不超过 2048 像素。</view>
        <view class="field-hint">更换材质后，引用它的成就背面会同步更新。</view>
      </view>

      <view class="form-section">
        <view class="section-title">名称文字色</view>
        <!-- 预览：榜单等处的名称文字，以及「我的成就」卡片右侧的档位胶囊 -->
        <view class="color-preview">
          <text class="preview-name" style="color: {{form.color || autoColor || 'var(--color-black-min)'}}">{{form.name || '成就名称'}}</text>
          <text class="preview-pill" style="{{pillStyle}}">{{form.name || '成就名称'}}</text>
        </view>
        <view class="chip-row">
          <view class="h-filter-item {{customColor ? '' : 'active'}}" bindtap="useAutoColor" aria-role="button" aria-label="自动取色">
            <view class="color-dot" wx:if="{{autoColor}}" style="background: {{autoColor}}"></view>自动
          </view>
          <view class="h-filter-item {{customColor ? 'active' : ''}}" bindtap="openCustomColor" aria-role="button" aria-label="自定义颜色">
            <view class="color-dot rainbow"></view>自定义
          </view>
        </view>

        <!-- 自定义：色相 / 饱和度 / 明暗三条滑杆，或直接输入色值 -->
        <view class="custom-color" wx:if="{{customColor}}">
          <view class="hsl-row">
            <text class="hsl-label">色相</text>
            <slider-control class="hsl-slider" min="0" max="359" value="{{hsl.h}}" track="linear-gradient(90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00)" data-key="h" bind:changing="onHsl" bind:change="onHsl" aria-label="色相" />
          </view>
          <view class="hsl-row">
            <text class="hsl-label">饱和</text>
            <slider-control class="hsl-slider" min="0" max="100" value="{{hsl.s}}" track="linear-gradient(90deg, {{hslTracks.s0}}, {{hslTracks.s1}})" data-key="s" bind:changing="onHsl" bind:change="onHsl" aria-label="饱和度" />
          </view>
          <view class="hsl-row">
            <text class="hsl-label">明暗</text>
            <slider-control class="hsl-slider" min="0" max="100" value="{{hsl.l}}" track="linear-gradient(90deg, #000, {{hslTracks.l50}}, #fff)" data-key="l" bind:changing="onHsl" bind:change="onHsl" aria-label="明暗" />
          </view>
          <view class="hex-row">
            <view class="color-dot hex-dot" style="background: {{form.color}}"></view>
            <input class="field-input hex-input" value="{{hexInput}}" maxlength="7" placeholder="#RRGGBB" bindinput="onHexInput" aria-label="色值" />
          </view>
          <view class="field-hint warn" wx:if="{{lowContrast}}">偏浅，白底上可能看不清</view>
        </view>
        <view class="field-hint" wx:if="{{!customColor && (imageChanged || !autoColor)}}">保存后按图片取色</view>
      </view>
    </block>

    <block wx:else>
      <view class="form-section">
        <view class="section-heading">
          <view class="section-title">规则</view>
          <text class="readonly-tag" wx:if="{{ruleLocked}}">已锁定</text>
        </view>
        <view class="path-row">
          <view class="path-col">
            <view class="field-label field-required">系列</view>
            <input class="field-input" value="{{form.series}}" maxlength="20" placeholder="例如：日常" data-field="series" bindinput="onInput" aria-label="系列" />
          </view>
          <text class="path-sep">›</text>
          <view class="path-col">
            <view class="field-label field-required">类别</view>
            <picker range="{{metricOptions}}" range-key="name" value="{{metricIndex}}" data-field="metric" bindchange="onPick" disabled="{{ruleLocked}}">
              <view class="field-picker {{ruleLocked ? 'locked' : ''}}">{{metricOptions[metricIndex].name}}<view class="picker-arrow" wx:if="{{!ruleLocked}}"></view></view>
            </picker>
          </view>
        </view>
        <view class="chip-row" wx:if="{{seriesOptions.length}}">
          <view class="chip {{form.series === item ? 'active' : ''}}" wx:for="{{seriesOptions}}" wx:key="*this" data-series="{{item}}" bindtap="pickSeries">{{item}}</view>
        </view>
        <view class="quantity-row">
          <view class="quantity-label {{ruleLocked ? '' : 'field-required'}}">{{metricOptions[metricIndex].label}}</view>
          <view class="count-field {{ruleLocked ? 'locked' : ''}}">
            <input class="count-input" type="number" maxlength="6" value="{{form.rule.count}}" disabled="{{ruleLocked}}" data-field="rule.count" bindinput="onInput" aria-label="达成数量" />
            <text class="count-unit">{{metricOptions[metricIndex].unit}}</text>
          </view>
        </view>
      </view>

      <view class="form-section">
        <view class="section-title">外观</view>
        <view class="field-label field-required">材质</view>
        <picker range="{{materialOptions}}" range-key="name" value="{{materialIndex}}" data-field="material" bindchange="onPick" disabled="{{!materialOptions.length}}">
          <view class="field-picker">{{selectedMaterial.name || '请先在材质库添加材质'}}<view class="picker-arrow" wx:if="{{materialOptions.length}}"></view></view>
        </picker>
        <view class="face-grid">
          <view class="face-column">
            <view class="face-tile front-tile" data-field="frontImage" bindtap="chooseImage" aria-role="button" aria-label="{{form.frontImage ? '更换正面图片' : '上传正面图片'}}">
              <image wx:if="{{previews.frontImage}}" class="face-image" src="{{previews.frontImage}}" mode="aspectFit" />
              <text wx:else class="iconfont icon-photo-up upload-icon"></text>
            </view>
            <view class="face-label"><text class="field-required">正面</text> · <text class="upload-link">{{form.frontImage ? '更换图片' : '上传图片'}}</text></view>
          </view>
          <view class="face-column">
            <view class="face-tile">
              <image wx:if="{{previews.backImage && !backPending}}" class="face-image" src="{{previews.backImage}}" mode="aspectFit" />
              <view class="auto-back" wx:else>保存后生成</view>
            </view>
            <view class="face-label">背面 · 自动生成</view>
          </view>
        </view>
        <view class="field-hint">正面使用透明 PNG，最大 5 MB，宽高不超过 2048 像素。</view>
        <view class="field-hint" wx:if="{{backPending && form.frontImage}}">保存后自动生成背面和 3D 轮廓。</view>
      </view>

      <view class="form-section status-section">
        <view class="status-row">
          <view class="status-copy">
            <view class="status-title">上线</view>
            <view class="field-hint">{{form.status === 'active' ? '按达成条件自动发放' : '保存为草稿，暂不展示和发放'}}</view>
          </view>
          <switch checked="{{form.status === 'active'}}" disabled="{{form.status === 'active' && holders > 0}}" color="var(--color-green)" bindchange="onStatusChange" aria-label="上线成就" />
        </view>
        <view class="holder-note" wx:if="{{!isNew}}">{{holders > 0 ? '已有 ' + holders + ' 人获得，不能退回草稿' : '尚无人获得'}}</view>
      </view>

    </block>

    <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
    <view class="save-bar">
      <!-- 保存进度跟着按钮走：按钮文字显示当前步骤，顶边细条显示完成比例 -->
      <view class="save-progress progress-line" wx:if="{{saving && !deleting && generation}}">
        <view class="progress-line-fill {{generation.status === 'complete' ? 'done' : ''}}" style="width: {{generation.status === 'complete' ? 100 : (generation.total ? (generation.step + 1) * 100 / (generation.total + 1) : 8)}}%"></view>
      </view>
      <button class="form-button danger delete-button" wx:if="{{mode === 'badge' && !isNew && holders === 0}}" bindtap="remove" loading="{{deleting}}" disabled="{{saving || uploading}}">{{deleting ? '删除中' : '删除成就'}}</button>
      <button class="form-button primary save-button" bindtap="save" loading="{{(saving && !deleting && generation.status !== 'complete') || uploading}}" disabled="{{saving || uploading}}">{{uploading ? '图片上传中' : (saving && !deleting && generation ? generation.label : (mode === 'material' ? '保存材质' : (isNew ? (form.status === 'active' ? '保存并上线' : '保存草稿') : '保存修改')))}}</button>
    </view>
  </view>
</block>
<no-auth wx:else tip-text="{{tipText}}"></no-auth>
