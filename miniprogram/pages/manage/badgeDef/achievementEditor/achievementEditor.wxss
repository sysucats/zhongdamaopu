@import "/pages/public/wxss/form.wxss";


.face-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.face-column {
  min-width: 0;
}

.face-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 236rpx;
  border-radius: var(--radius-lg);
  background: var(--color-gray-light);
}

.face-image {
  display: block;
  width: 200rpx;
  max-width: 100%;
  height: 200rpx;
}

.face-label {
  margin-top: 14rpx;
  text-align: center;
  color: var(--color-gray-max);
  font-size: 23rpx;
  line-height: 1.5;
}

.auto-back {
  color: var(--color-gray-max);
  font-size: 23rpx;
}

.material-image {
  display: block;
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-md);
}

.holder-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-gray-normal);
  color: var(--color-gray-max);
  font-size: 23rpx;
  line-height: 1.5;
}

/* 保存进度：贴在底栏顶边的细条 */
.save-progress {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--color-gray-light);
}

.save-progress-fill {
  height: 100%;
  background: var(--color-primary);
  transition: width .4s ease;
}

.save-progress-fill.done { background: var(--color-green); }

.save-button { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 所属分类：系列 › 类别 并排，箭头表达层级 */
.path-row {
  display: flex;
  align-items: flex-end;
  gap: var(--space-sm);
}
.path-col {
  flex: 1;
  min-width: 0;
}
.path-sep {
  flex-shrink: 0;
  padding-bottom: 20rpx;
  color: var(--color-gray-max);
  font-size: 36rpx;
  line-height: 48rpx;
}
.field-picker.locked,
.count-field.locked .count-input,
.count-field.locked .count-unit {
  color: var(--color-gray-max);
}
