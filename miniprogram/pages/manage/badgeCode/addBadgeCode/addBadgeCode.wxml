<view class="form-page" wx:if="{{auth}}">
  <view class="form-section">
    <view class="field-label field-required">可抽取徽章等级</view>
    <input class="field-input" type="text" placeholder="请输入" value="{{input.badgeLevel}}" bindinput="onChangeText" data-field="badgeLevel" data-dtype="text" />
    <view class="field-hint">只能是 [{{allBadgeLevels}}] 的子集，输入其他字符无效</view>

    <view class="field-label spaced-label field-required">兑换个数</view>
    <view class="count-field">
      <input class="count-input" type="number" placeholder="请输入" value="{{input.badgeCount}}" bindinput="onChangeText" data-field="badgeCount" data-dtype="number" />
      <text class="count-unit">枚</text>
    </view>
    <view class="field-hint">单个兑换码可以兑换多少枚徽章</view>

    <view class="field-label spaced-label field-required">生成码个数</view>
    <view class="count-field">
      <input class="count-input" type="number" placeholder="请输入" value="{{input.genCount}}" bindinput="onChangeText" data-field="genCount" data-dtype="number" />
      <text class="count-unit">个</text>
    </view>
    <view class="field-hint">生成多少个兑换码</view>

    <view class="field-label spaced-label">生成原因</view>
    <input class="field-input" type="text" placeholder="请输入" value="{{input.genReason}}" bindinput="onChangeText" data-field="genReason" data-dtype="text" />
    <view class="field-hint">用于后期管理，例如xx义卖活动</view>

    <view class="field-label spaced-label field-required">有效期</view>
    <view class="count-field">
      <input class="count-input" type="number" placeholder="请输入" value="{{input.validDays}}" bindinput="onChangeText" data-field="validDays" data-dtype="number" />
      <text class="count-unit">天</text>
    </view>
    <view class="field-hint">多少天后兑换码失效，为0表示永久有效</view>
  </view>
  <view class="save-bar">
    <button class="form-button primary save-button" bindtap="clickSubmit">提交</button>
  </view>
</view>
<no-auth wx:else tip-text="{{tipText}}"></no-auth>
