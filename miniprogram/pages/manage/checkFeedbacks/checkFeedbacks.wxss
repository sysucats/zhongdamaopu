@import "../adminPage.wxss";
@import "/pages/public/wxss/review.wxss";
@import "/pages/public/wxss/formControls.wxss";
@import "/pages/public/wxss/iconfont.wxss";

page {
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg)
    calc(140rpx + env(safe-area-inset-bottom));
  background: var(--color-gray-light);
}
.reply-heading {
  flex-wrap: wrap;
  color: var(--color-black-min);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}
.feedback-meta {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-sm);
  margin-top: var(--space-sm);
  color: var(--color-gray-max);
  font-size: 23rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.feedback-content,
.reply-content {
  display: block;
  color: var(--color-black-light);
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.feedback-contact {
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
  margin-top: var(--space-md);
  color: var(--color-black-min);
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  align-items: flex-end;
  text-align: right;
}
.contact-label { color: var(--color-gray-max); font-size: 23rpx; }
.feedback-reply {
  margin-top: var(--space-md);
}
.reply-date { color: var(--color-gray-max); font-size: 22rpx; }
.reply-content { color: var(--color-text-onPrimary); font-size: 26rpx; }
.feedback-notice {
  margin-top: var(--space-md);
  color: var(--color-gray-max);
  font-size: 24rpx;
  line-height: 1.6;
}
.form-button.feedback-copy { margin-right: auto; }
.feedback-empty {
  padding: 100rpx 0;
  text-align: center;
  color: var(--color-gray-max);
  font-size: 28rpx;
}
