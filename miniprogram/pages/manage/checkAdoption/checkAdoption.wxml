<block wx:if="{{auth}}">
  <view class="admin-segments">
    <view class="admin-segment {{activeTab === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
  </view>
  <view class="admin-page-hint" wx:if="{{loading}}">加载中…</view>
  <view wx:elif="{{loadError}}">
    <view class="admin-page-hint">{{loadError}}</view>
    <button class="form-button compact" bindtap="loadList">重新加载</button>
  </view>
  <view class="adoption-empty content-note" wx:elif="{{!list.length}}">暂无{{statusDesc[activeTab]}}的申请</view>

  <view class="review-card" wx:for="{{list}}" wx:key="_id">
    <view class="review-heading">
      <view class="review-subject" bindtap="toCatDetail" data-cat_id="{{item.cat_id}}" aria-role="button" aria-label="查看{{item.cat_name}}">
        <image class="review-avatar" mode="aspectFill" src="{{item.cat_avatar}}" />
        <view class="review-subject-copy"><view class="review-name">{{item.cat_name}}</view><view class="review-location" wx:if="{{item.cat_campus || item.cat_area}}">{{item.cat_campus}} {{item.cat_area}}</view></view>
        <text class="iconfont icon-chevron-right review-chevron"></text>
      </view>
      <view class="status-tag review-state status-{{item.status}}">{{statusDesc[item.status]}}</view>
    </view>
    <view class="review-meta applicant-meta"><text>申请人：{{item.applicant_name}}</text><text>{{item.apply_time_formatted}}</text></view>
    <view class="review-bubble user-bubble"><text class="review-content" selectable="{{true}}">{{item.reason}}</text></view>
    <view class="content-note contact-label">联系方式</view>
    <view class="adoption-contact">
      <text class="contact-copy" selectable="{{true}}">{{item.contact}}</text>
      <button class="form-button compact with-icon" bindtap="copyContact" data-contact="{{item.contact}}" aria-label="复制联系方式"><text class="iconfont icon-copy"></text><text>复制</text></button>
    </view>

    <view class="latest-review" wx:if="{{item.status !== 'pending'}}">
      <view class="review-meta"><text>{{item.reviewerInfo.nickName || '未知审核人'}}</text><text>{{item.review_time_formatted}}</text></view>
      <view class="review-content">{{item.review_note || statusDesc[item.status]}}</view>
    </view>

    <view class="review-log" wx:if="{{item.timeline && item.timeline.length}}">
      <button class="form-button compact with-icon log-toggle" bindtap="toggleTimeline" data-index="{{index}}" aria-label="{{item.showTimeline ? '收起审核记录' : '展开审核记录'}}">
        <text>审核记录 {{item.timeline.length}}</text>
        <text class="iconfont {{item.showTimeline ? 'icon-arrow-up' : 'icon-arrow-down'}}"></text>
      </button>
      <view wx:if="{{item.showTimeline}}">
        <view class="review-log-item" wx:for="{{item.timeline}}" wx:for-item="t" wx:key="index">
          <text class="iconfont {{statusIcon[t.status] || 'icon-history'}} status-{{t.status}} log-status-icon"></text>
          <view class="log-copy">
            <view class="log-heading"><text>{{t.status_desc}}</text><text class="content-note">{{t.time_formatted}}</text></view>
            <view class="content-text log-note">{{t.note}}</view>
            <view class="content-note" wx:if="{{t.operatorInfo}}">{{t.operatorInfo.nickName}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card-actions" wx:if="{{item.status === 'pending' || item.status === 'reviewing'}}">
      <button class="form-button compact with-icon danger reject-action" bindtap="openReview" data-action="reject" data-index="{{index}}" disabled="{{submitting}}"><text class="iconfont icon-close"></text><text>拒绝</text></button>
      <button class="form-button compact with-icon" bindtap="openReview" data-action="{{item.status === 'pending' ? 'processing' : 'note'}}" data-index="{{index}}" disabled="{{submitting}}"><text class="iconfont icon-edit"></text><text>{{item.status === 'pending' ? '开始审核' : '记录进度'}}</text></button>
      <button class="form-button compact with-icon primary" bindtap="openReview" data-action="approve" data-index="{{index}}" disabled="{{submitting}}"><text class="iconfont icon-check"></text><text>通过</text></button>
    </view>
  </view>
</block>
<no-auth wx:else tip-text="{{tipText}}" />

<popup style="--popup-background: var(--color-surface);" show="{{showReviewPanel}}" bind:close="closeReview" close-on-mask="{{!submitting}}">
  <view class="adoption-editor" wx:if="{{reviewTarget}}">
    <popup-header title="{{reviewAction === 'approve' ? '通过申请' : reviewAction === 'reject' ? '拒绝申请' : reviewAction === 'processing' ? '开始审核' : '记录进度'}}" close-position="left" confirm="{{true}}" disabled="{{!canConfirm}}" busy="{{submitting}}" bind:close="closeReview" bind:confirm="confirmReview" />
    <view class="editor-body">
      <view class="content-title editor-parties"><text>{{reviewTarget.applicant_name}}</text><text class="iconfont icon-chevrons-right"></text><text>{{reviewTarget.cat_name}}</text></view>
      <view class="field-label {{reviewAction === 'note' ? 'field-required' : ''}}">{{reviewAction === 'note' ? '进度说明' : '审核说明（选填）'}}</view>
      <textarea class="description-input" placeholder="{{reviewAction === 'note' ? '例如：已电话沟通，等待补充居住环境照片' : '填写本次审核说明'}}" value="{{reviewNote}}" bindinput="onNoteInput" disabled="{{submitting}}" maxlength="200" />
      <view class="field-hint">申请人可见</view>
    </view>
  </view>
</popup>
