/* 领养审核页 - 骨架复用 checkFeedbacks（已验证可正常渲染），配色走主题变量 */
page {
  width: 750rpx;
  padding: 250rpx 30rpx 150rpx 30rpx;
  box-sizing: border-box;
}

button {
  width: 47%;
  display: inline-block;
  font-size: 30rpx;
  box-sizing: border-box;
}

button.primary {
  background-color: var(--color-primary);
  color: var(--color-text-onPrimary);
  margin-top: 8rpx;
}

button + button {
  margin-left: 5%;
}

button.long {
  margin: 0;
  width: 100%;
}

button.btn-reject {
  color: #f5222d;
  border: 1rpx solid #f5222d;
  background: #fff;
  margin-top: 8rpx;
}

/* 顶部固定栏 */
#tips {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  z-index: 1;
  font-size: 28rpx;
  color: var(--color-gray-max);
  box-shadow: 0rpx 0rpx 30rpx var(--color-gray);
  padding: 24rpx 30rpx;
  background-color: #FFFFFF;
}

#tips text {
  display: block;
  width: 100%;
  text-align: center;
}

/* 状态切换 */
.tabs {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.tab {
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
}

.tab.active {
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
  font-weight: bold;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* 审核面板（内嵌） */
.review-panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0rpx 0rpx 30rpx var(--color-gray);
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

.panel-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-top: 12rpx;
}

.panel-textarea {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  margin-top: 24rpx;
}

.panel-buttons {
  margin-top: 24rpx;
}

/* 申请卡片（复用 verify-box 骨架） */
.verify-box {
  box-sizing: border-box;
  margin-bottom: 50rpx;
  padding: 40rpx 40rpx 30rpx 40rpx;
  box-shadow: 0rpx 0rpx 30rpx var(--color-gray);
  border-radius: 20rpx;
  background-color: #FFFFFF;
}

.line {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-black-light);
  margin-bottom: 16rpx;
}

.line image.icon {
  height: 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  margin-right: 15rpx;
}

.line image.icon.cat-avatar {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.line text {
  text-decoration: underline;
}

/* 状态徽章 */
.status-badge {
  font-size: 22rpx;
  font-weight: normal;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  margin-left: auto;
  flex-shrink: 0;
}

.status-pending { background: #fff7e6; color: #fa8c16; }
.status-reviewing { background: #e6f7ff; color: #1890ff; }
.status-approved { background: #f6ffed; color: #52c41a; }
.status-rejected { background: #fff1f0; color: #f5222d; }
.status-cancelled { background: #f5f5f5; color: #999; }

.status-bg-pending { background: #fa8c16; }
.status-bg-reviewing { background: #1890ff; }
.status-bg-approved { background: #52c41a; }
.status-bg-rejected { background: #f5222d; }
.status-bg-cancelled { background: #999; }

/* 气泡（复用 checkFeedbacks 结构） */
.bubble1, .bubble2 {
  margin-bottom: 12rpx;
}

.bubble1 .date, .bubble2 .date {
  font-size: 28rpx;
  color: var(--color-gray-max);
  text-align: left;
}

.bubble1 .name, .bubble2 .name {
  font-size: 28rpx;
  color: var(--color-gray-max);
}

.bubble1 .name { text-align: left; }
.bubble2 .name { text-align: left; }

.bubble1 .floating, .bubble2 .floating {
  width: max-content;
  max-width: 90%;
}

.bubble1 .floating { margin: 0; }
.bubble2 .floating { margin: 0 auto 0 0; }

.bubble1 .floating::after, .bubble2 .floating::after {
  display: block;
  content: "";
  clear: both;
}

.bubble1 .floating .content, .bubble2 .floating .content {
  clear: both;
  position: relative;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.bubble1 .floating .content {
  float: left;
  background: var(--color-gray);
}

.bubble2 .floating .content {
  float: left;
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
}

.bubble1 .floating .footer {
  float: left;
  clear: both;
  background-color: var(--color-gray-light);
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 4rpx 20rpx;
  margin-top: 4rpx;
}

/* 流转记录 */
.timeline-toggle {
  font-size: 24rpx;
  color: var(--color-primary-text);
  margin: 12rpx 0;
  text-align: left;
}

.timeline {
  border-left: 4rpx solid #f0f0f0;
  margin: 12rpx 0 12rpx 10rpx;
  padding-left: 24rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.timeline-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-status {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.timeline-time {
  font-size: 22rpx;
  color: #999;
}

.timeline-note {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
  line-height: 1.5;
}

.timeline-operator {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
