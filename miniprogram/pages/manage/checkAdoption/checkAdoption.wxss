@import "../adminPage.wxss";
@import "/pages/public/wxss/formControls.wxss";
@import "/pages/public/wxss/review.wxss";
@import "/pages/public/wxss/iconfont.wxss";

page {
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg)
    calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-gray-light);
}
.adoption-empty { padding: 100rpx 0; text-align: center; }
.applicant-meta { justify-content: flex-end; }
.adoption-contact {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
  color: var(--color-black-min);
  font-size: var(--font-size-body);
  line-height: 1.6;
}
.contact-label { margin-top: var(--space-md); }
.contact-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.latest-review { margin-top: var(--space-md); }
.latest-review .review-content { margin-top: var(--space-xs); }
.review-log { margin-top: var(--space-md); }
.form-button.log-toggle {
  width: 100%;
  justify-content: flex-start;
  background: transparent;
  padding: 0;
  color: var(--color-gray-max);
}
.log-toggle .iconfont:last-child { margin-left: auto; }
.review-log-item {
  position: relative;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}
.review-log-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 56rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: var(--color-gray-normal);
}
.log-status-icon {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1.5;
  background: var(--color-surface);
}
.log-copy { flex: 1; min-width: 0; }
.log-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-xs); font-size: var(--font-size-caption); font-weight: 500; }
.log-note { margin: var(--space-xs) 0; font-size: var(--font-size-caption); }
.card-actions .reject-action { margin-right: auto; }
.adoption-editor { padding: 0 var(--space-md); }
.editor-body { padding: 0 0 calc(var(--space-lg) + env(safe-area-inset-bottom)); }
.editor-body .description-input { border: 1rpx solid var(--color-gray-normal); }
.editor-parties { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-xs); }
.editor-parties .iconfont { color: var(--color-gray-max); font-size: 30rpx; }
