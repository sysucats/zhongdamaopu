@import "/pages/public/wxss/form.wxss";

.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-gray-light);
}

.filter-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

.filter-name {
  color: var(--color-black-light);
  font-size: 27rpx;
  line-height: 1.5;
}

.filter-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.filter-move .iconfont {
  font-size: 28rpx;
  color: inherit;
}

.filter-category + .filter-category {
  margin-top: var(--space-lg);
}

.filter-category-title {
  margin-bottom: var(--space-sm);
  color: var(--color-black-min);
  font-size: 28rpx;
  font-weight: 500;
}

.coord-text {
  color: var(--color-gray-max);
}

.filter-add,
.filter-add-form {
  margin-top: var(--space-md);
}

.filter-add .iconfont {
  font-size: 36rpx;
  color: inherit;
}

/* ========== 地图选点浮层 ========== */
.picker-map {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

/* 十字准星 */
.picker-crosshair {
  position: fixed;
  top: 50%;
  left: 50%;
  margin-left: -30rpx;
  margin-top: -30rpx;
  width: 60rpx;
  height: 60rpx;
  pointer-events: none;
}

.crosshair-v {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  background: var(--color-filter-accent);
  margin-left: -2rpx;
  border-radius: 2rpx;
}

.crosshair-h {
  position: absolute;
  top: 50%;
  left: 0;
  height: 4rpx;
  width: 100%;
  background: var(--color-filter-accent);
  margin-top: -2rpx;
  border-radius: 2rpx;
}

/* 顶部信息栏 */
/* 底部操作栏 */
/* 缩放按钮 */
.picker-zoom-bar {
  position: fixed;
  right: 24rpx;
  top: 50%;
  margin-top: -80rpx;
  width: 72rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.zoom-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 300;
  color: #333333;
  background: transparent;
}

.zoom-divider {
  width: 52rpx;
  height: 1rpx;
  background: var(--color-divider);
  margin: 0 auto;
}

.picker-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)) 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, transparent 100%);
}

.picker-btn {
  flex: 1;
  margin: 0 8rpx;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.picker-btn.delete {
  background: var(--color-red);
  color: var(--color-text-inverse);
}

.picker-btn.delete:active {
  background: var(--color-red-dark);
}

/* 校区管理的地图选点栏。 */
.picker-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--color-surface);
}

.picker-toolbar {
  position: relative;
  height: 88rpx;
}

.picker-toolbar-title {
  margin: 0 88rpx;
  color: var(--color-black-light);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.picker-toolbar-button {
  position: absolute;
  top: 0;
  width: 88rpx;
  height: 88rpx;
}

.picker-toolbar-left {
  left: 0;
}

.picker-toolbar-right {
  right: 0;
}

.picker-close-line {
  position: absolute;
  top: 43rpx;
  left: 26rpx;
  width: 36rpx;
  height: 3rpx;
  background: var(--color-black-min);
  transform: rotate(45deg);
}

.picker-close-line.alternate {
  transform: rotate(-45deg);
}

.picker-confirm-mark {
  position: absolute;
  top: 27rpx;
  left: 34rpx;
  width: 18rpx;
  height: 30rpx;
  border-right: 3rpx solid var(--color-black-min);
  border-bottom: 3rpx solid var(--color-black-min);
  transform: rotate(45deg);
}

.picker-coords-display {
  color: var(--color-gray-max);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}
