@import "/pages/public/wxss/formControls.wxss";
@import "../adminPage.wxss";

page { background: var(--color-gray-light); }
.rewards-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.reward-editor.description-input.long-input {
  height: 440rpx;
  min-height: 440rpx;
}
.editor-hint { margin-bottom: var(--space-sm); }
.record-preview.collapsed {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}
.preview-toggle { margin-right: auto; }
