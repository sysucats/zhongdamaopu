@import "../adminPage.wxss";
@import "/pages/public/wxss/button.wxss";
@import "/pages/public/wxss/review.wxss";
@import "/pages/public/wxss/hFilter.wxss";

page {
  width: 750rpx;
  padding: 35rpx 35rpx 160rpx 35rpx;
  box-sizing: border-box;
  background: var(--color-gray-light);
}

button {
  width: 47%;
  display: inline-block;
  font-size: 30rpx;
  box-sizing: border-box;
}

button.primary {
  background-color: var(--color-primary);
  color: var(--color-text-onPrimary);
}

button + button {
  margin-left: 6%;
  /* float: right; */
}

button.long {
  margin: 20rpx 0 0 0;
  width: 100%;
}

.info-box {
  width: 100%;
  display: flex;
  flex-direction: row;
}

image {
  border-radius: 10rpx;
  width: 210rpx;
  height: 210rpx;
  background-color: var(--color-gray-light);
  margin-top: 10rpx;
}

.review-card .info-box .info {
  margin-left: 20rpx;
}
.review-card .label.user { color: var(--color-gray-max); line-height: 1.7; }
.review-card .info-box > image { flex-shrink: 0; margin-top: 0; }

.card-actions .review-option.danger { margin-right: auto; }

.label {
  font-size: 24rpx;
  font-weight: 300;
}

.label.user.shotTime{
  margin-bottom: 20rpx;
}


/* 校区选择器 */
.h-filter-list.campus-list {
  width: 100%;
  padding: var(--space-xs) 0;
  margin-bottom: var(--space-xs);
}

/* 提示选择 */
.tip {
  width: 100%;
  font-size: 24rpx;
  color: var(--color-gray-dark);
  text-align: center;
}

/* 审核记录 */
.history-box {
  display: flex;
  gap: var(--space-md);
  flex-direction: row;
  align-items: flex-start;
}

.history-box .info {
  flex: 1;
  min-width: 0;
}

.history-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.history-summary {
  font-size: 24rpx;
  color: var(--color-gray-dark);
}

.img-toggle {
  font-size: 24rpx;
  color: var(--color-gray-dark);
}

.img-toggle checkbox-group {
  display: inline-flex;
  align-items: center;
}

.history-box image,
.img-deleted,
.img-hidden {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.img-deleted,
.img-hidden {
  border-radius: 10rpx;
  background-color: var(--color-gray-light);
  color: var(--color-gray-dark);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}

/* 可点击加载单张图片 */
.img-hidden {
  color: var(--color-primary-text);
}

.img-hidden:active {
  opacity: 0.7;
}
