@import "/pages/public/wxss/form.wxss";

.setting-description {
  margin-top: 0;
}

.setting-field {
  margin-top: var(--space-lg);
}

.setting-field + .setting-field {
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-gray-normal);
}

.setting-choice {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: 72rpx;
  color: var(--color-black-min);
  font-size: 26rpx;
  line-height: 1.5;
}

.setting-field .status-copy {
  margin-top: 0;
}

.field-input[disabled] {
  color: var(--color-gray-max);
}
