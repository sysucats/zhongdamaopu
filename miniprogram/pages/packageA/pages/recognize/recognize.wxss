/* pages/recognize/recognize.wxss */
@import "/pages/public/wxss/card.wxss";
@import "/pages/public/wxss/cat-list.wxss";
@import "/pages/public/wxss/button.wxss";
@import "/pages/public/wxss/tag.wxss";
@import "/pages/public/wxss/rank-ticket.wxss";

page {
  min-height: 100vh;
  background: var(--color-gray-light);
}

#positionWrapper {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 50%;
  transform: translateX(-50%) translateY(-50%);
  transition: top 0.5s ease-in-out, transform 0.5s ease-in-out;
}

#positionWrapper.flowUp {
  top: 4%;
  transform: translateX(-50%);
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
}

#photoBox, #resultBox, #adBox {
  width: 675rpx;
}

#photoBox {
  padding: 0;
  overflow: hidden;
}

#previewArea {
  width: 675rpx;
  height: 675rpx;
  background-color: var(--color-gray-dark);
}

#authTips {
  width: 90%;
  text-align: center;
  position: absolute;
  top: calc(675rpx / 2);
  left: 50%;
  transform: translateX(-50%) translateY(-50%);
}

#authTips text {
  font-size: 30rpx;
  color: white;
}

#authTips button {
  width: 300rpx;
  margin: var(--space-xl) auto 0;
}

#cameraPreview, #photoPreview {
  width: 100%;
  height: 100%;
}

#photoPreview {
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
  position: relative;
}

#photoPreview .catBox {
  position: absolute;
  /* top,left,width,height在wxml中绑定JS计算结果 */
  border: 4rpx solid var(--color-gray);
  border-radius: 10rpx;
  box-sizing: border-box;
}

#photoPreview .catBox.chosen {
  border-color: var(--color-primary);
}

#cameraControll {
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
  height: 180rpx;
  transition: height 1s ease-in-out;
}

#cameraControll.shrink {
  height: 0;
}

#cameraControll .btn {
  width: 80rpx;
  height: 80rpx;
}

#shutter {
  width: 100rpx;
  height: 100rpx;
  background-color: var(--color-primary);
  border-radius: 50rpx;
  border: 8rpx solid white;
  box-shadow: 0 0 0 8rpx var(--color-primary);
}

#shutter::after {
  /*去掉微信自带按钮组件样式*/
  border: none;
}

#shutter:active {
  background-color: var(--color-primary-dark);
}

#resetButton {
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
}

#resetButton image {
  width: 24rpx;
  height: 24rpx;
}

#shutter[disabled] {
  background-color: var(--color-gray);
}

#resultBox .tip {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
}

#resultBox .tip image.icon,
.cat-card .line image.icon {
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
  margin-right: var(--space-xs);
}

.footnote {
  margin-top: var(--space-md);
}

.bgImg {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100vh;
  pointer-events: none;
}

.filter {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.filter .picker {
  gap: var(--space-xs);
}

.filter .picker .iconfont {
  font-size: 24rpx;
  color: inherit;
}

/* 结果容器已有内边距，猫猫列表项不重复添加。 */
.cat-card {
  padding: 0;
}

.cat-card:active {
  background: var(--color-gray-light);
}

.cat-card .line {
  display: flex;
  align-items: center;
}

.cat-card .line.first {
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.cat-card .cat-name-group {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
}

.cat-card .gender {
  flex-shrink: 0;
  width: 27rpx;
  height: 27rpx;
  margin-left: var(--space-xs);
}

/* 概率刻度和第四名后的弱化效果仅用于识猫页。 */
.cat-card .prob {
  width: 176rpx;
  margin-left: var(--space-sm);
}
.prob .rank-ticket-value {
  margin-bottom: 14rpx;
}
.prob-meter {
  height: 4rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: var(--color-gray-normal);
}
.prob-meter-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--rank-ticket-accent);
}
.prob-secondary .rank-ticket-value {
  margin: 0;
  color: var(--color-gray-max);
}
.prob-secondary .rank-ticket-number {
  font-size: 36rpx;
  font-weight: 500;
}

.ad-tip {
  margin-bottom: var(--space-xs);
  text-align: center;
}

#adBox {
  margin-bottom: var(--space-md);
}
