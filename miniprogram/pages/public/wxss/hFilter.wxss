@import "../wxss/iconfont.wxss";
@import "./tag.wxss";

.h-filter-list {
  width: 750rpx;
  min-height: 80rpx;
  flex-direction: row;
  padding: 8rpx 20rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.h-filter-item {
  display: inline-flex;
  min-height: 64rpx;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
  border: 2rpx solid var(--color-gray);
  transition: color 100ms ease,
        background-color 200ms ease,
        border-color 200ms ease,
        font-weight 200ms ease;
  box-sizing: border-box;
}

/* 防止后导入的标签基础样式清除间距。 */
.h-filter-list .h-filter-item {
  margin: 0 var(--space-xs);
}

.h-filter-item.long {
  min-width: 132rpx;
  justify-content: center;
}

.h-filter-item.active {
  border-color: var(--color-primary);
}

.h-filter-item .location-logo {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}


.h-filter-item .icon-clock {
  font-family: 'iconfont';
  font-size: 28rpx;
  margin-right: 4rpx;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
