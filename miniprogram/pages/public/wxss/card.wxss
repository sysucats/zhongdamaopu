/* 表单、审核和反馈共用的卡片容器。 */
.form-section,
.review-card,
.feedback-card,
.content-card {
  box-sizing: border-box;
  margin-bottom: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-xl);
  background: var(--color-surface);
}

/* 内容页：标题、正文和分组记录。 */
.content-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-md) var(--space-lg)
    calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-gray-light);
}
/* 分区标题与子分组标题。 */
.section-title,
.content-title {
  margin-bottom: var(--space-md);
  color: var(--color-black-light);
  font-size: var(--font-size-section);
  font-weight: 600;
}
.content-title { line-height: 1.5; }
.section-subtitle,
.content-group-heading {
  color: var(--color-black-light);
  font-size: var(--font-size-body);
  font-weight: 500;
}
.content-text {
  color: var(--color-black-min);
  font-size: var(--font-size-body);
  font-weight: 400;
  line-height: 1.75;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.content-note {
  color: var(--color-gray-max);
  font-size: var(--font-size-caption);
  font-weight: 400;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.content-group + .content-group {
  margin-top: var(--space-lg);
  padding-top: var(--space-lg);
  border-top: 1rpx solid var(--color-gray-normal);
}
.content-group-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-sm);
  margin-bottom: var(--space-xs);
  line-height: 1.5;
}
.content-entry {
  display: flex;
  align-items: baseline;
  gap: var(--space-xs);
}
.content-entry > text:last-child {
  flex: 1;
  min-width: 0;
}

/* 卡片操作区：内容过多时换行。 */
.card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-lg);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-gray-normal);
}
