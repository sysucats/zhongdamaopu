@import "./formControls.wxss";

page {
  background: var(--color-gray-light);
}
.form-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-md) var(--space-lg)
    calc(180rpx + env(safe-area-inset-bottom));
}
.form-state {
  padding: 120rpx var(--space-lg);
  text-align: center;
  color: var(--color-gray-max);
  font-size: 27rpx;
  line-height: 1.6;
}
