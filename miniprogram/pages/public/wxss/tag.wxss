/* 胶囊外观；交互状态仅用于可点击选项。 */
.chip,
.tag-pill,
.h-filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 64rpx;
  margin: 0;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-gray-light);
  color: var(--color-black-min);
  font-size: var(--font-size-chip);
  font-weight: 400;
  line-height: 1.5;
}
.chip::after { border: none; }
.tag-pill {
  flex-shrink: 0;
  max-width: 100%;
  white-space: nowrap;
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-weight: 400;
}
.chip.active,
.h-filter-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-weight: 500;
}
.chip:active:not([disabled]),
.h-filter-item:active:not([disabled]) { background: var(--color-gray-normal); }
.chip.active:active:not([disabled]),
.h-filter-item.active:active:not([disabled]) { background: var(--color-primary); color: var(--color-text-onPrimary); }
.chip[disabled],
.h-filter-item[disabled] { background: var(--color-gray-normal); color: var(--color-gray-max); }

/* 静态分类标签：文字撑宽，不承担点击状态。 */
.relation-tag,
.record-type,
.medical-type-tag,
.tags .tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  max-width: 100%;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: var(--font-size-tag);
  font-weight: 400;
  line-height: 1.5;
  white-space: nowrap;
}

/* 领养状态：三个入口共用。 */
.status-tag {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-tag);
  font-weight: 400;
  line-height: 1.5;
  white-space: nowrap;
}
/* 色调底色统一走 --status-bg，拼接段也取这一份。 */
.status-pending { --status-bg: var(--color-status-pending-bg); background: var(--status-bg); color: var(--color-status-pending-text); }
.status-reviewing { --status-bg: var(--color-status-reviewing-bg); background: var(--status-bg); color: var(--color-status-reviewing-text); }
.status-approved { --status-bg: var(--color-status-success-bg); background: var(--status-bg); color: var(--color-green-dark); }
.status-rejected { --status-bg: var(--color-status-error-bg); background: var(--status-bg); color: var(--color-red-dark); }
.status-cancelled { --status-bg: var(--color-gray-normal); background: var(--status-bg); color: var(--color-black-min); }

/* 猫猫状态：各入口共用尺寸和排列。 */
.cat-status-list {
  display: flex;
  min-width: 0;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: var(--space-xs);
}
.cat-status-tag {
  flex-shrink: 0;
  min-height: 0;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

/* 拼接状态：一行一颗胶囊（行由 catStatus.wxs 切好），圆头按行裁切。 */
.cat-status-rows {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  max-width: 100%;
  min-width: 0;
}
.cat-status-joined {
  display: inline-flex;
  flex: 0 1 auto;
  max-width: 100%;
  gap: 4rpx;
  overflow-x: auto;
  border-radius: var(--radius-pill);
}
.cat-status-joined .cat-status-tag {
  position: relative;
  border-radius: 0;
  background: transparent;
}
.cat-status-joined .cat-status-tag::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 6rpx;
  /* 缺 tone 时退回灰底，避免裸文字。 */
  background: var(--status-bg, var(--color-gray-normal));
  transform: skewX(-18deg);
}
/* 两端外扩补偿斜切缺口（h/2·tan18°≈7rpx），当前被圆头盖住。 */
.cat-status-joined .cat-status-tag:first-child::before {
  left: -12rpx;
}
.cat-status-joined .cat-status-tag:last-child::before {
  right: -12rpx;
}
.cat-status-joined .cat-status-tag > text {
  position: relative;
}
.cat-status-joined .cat-status-tag:only-child {
  border-radius: var(--radius-pill);
  background: var(--status-bg, var(--color-gray-normal));
}
.cat-status-joined .cat-status-tag:only-child::before {
  display: none;
}
