@import "/pages/public/wxss/hFilter.wxss";
@import "/pages/public/wxss/card.wxss";

page {
  height: 100%;
  background: var(--color-gray-light);
}

.thread-list {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 100rpx 0 100rpx;
  overflow: hidden;
  background-color: var(--color-surface);
  box-sizing: border-box;
  box-shadow: 0rpx 0rpx 10rpx var(--color-gray);
}

.thread-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.thread-item-name {
  font-size: 28rpx;
  color: var(--color-gray-max);
}

.thread-item-bar {
  width: 100rpx;
  height: 4rpx;
  border-radius: 10rpx;
}

.thread-item.active .thread-item-bar {
  background-color: var(--color-primary);
}

.thread-item.active .thread-item-name {
  color: var(--color-black-light);
}

/* 左右滑动的频道内容 */
#main-swiper {
  /* TODO: 偷懒了，不一定充满屏幕 */
  min-height: 80%;
}

.main {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: 0 var(--space-lg);
}

.column {
  flex: 1;
  min-width: 0;
}

.column_item {
  width: 100%;
  padding: 0;
  overflow: hidden;
}

.column_pic {
  position: relative;
  /* width: 100%; */
  overflow: hidden;
}
.column_pic image {
  width: 100%;
  margin: 0;
  padding: 0;
  vertical-align: bottom;
}
.location {
  position: absolute;
  top: 18rpx;
  right: 15rpx;
  color: var(--color-gray);
  text-align: end;
  font-size: 18rpx;
  background-color: var(--color-black-transparent);
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
}

.info {
  width: 100%;
  display: flex;
  padding: 18rpx 0rpx 18rpx 24rpx;
  align-items: center;
  box-sizing: border-box;
  justify-content: space-between;
}

.names {
  display: inline-block;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.cat-name {
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  color: var(--color-black-min);
}
.cat-name .campus {
  font-size: 18rpx;
  color: var(--color-gray-dark);
  font-weight: lighter;
}

.photo-info {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}
.pher-name {
  font-size: 22rpx;
  color: var(--color-gray-max);
  margin-right: 16rpx;
}
.photo-date {
  font-size: 22rpx;
  color: var(--color-gray-max);
  flex-shrink: 0;
}

.like-button {
  /* width: 100rpx; */
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

heart {
  margin: -20rpx 0 -25rpx 0;
}

.like-num {
  width: 100rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-gray-max);
}

.hide {
  display: none;
}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx;
}
.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: 10rpx 0;
}

.ellipsis-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.h-filter-list {
  display: flex;
  justify-content: center;
}
.h-filter-item.long {
  margin: 20rpx 20rpx 20rpx 20rpx;
}

.achievement-showcase-dialog {
  box-sizing: border-box;
  width: 660rpx;
  max-width: calc(100vw - 48rpx);
  max-height: 78vh;
  overflow-y: auto;
  padding: 0 var(--space-md) 12rpx;
  border-radius: var(--radius-modal);
  background: var(--color-surface);
}

.achievement-showcase-state {
  padding: 96rpx 0;
  text-align: center;
  color: var(--color-gray-max);
  font-size: 26rpx;
}

.achievement-showcase-board {
  position: relative;
  height: 660rpx;
  margin-top: 8rpx;
  background: radial-gradient(ellipse at center, var(--color-warm-bg) 0%, var(--color-surface) 72%);
}

.achievement-showcase-board.count-1 {
  height: 460rpx;
}

.achievement-showcase-board.count-2 {
  height: 570rpx;
}

.achievement-showcase-placement {
  position: absolute;
  transform: translate(-50%, -50%);
}

.achievement-showcase-entry {
  transform-origin: center;
  animation: showcase-badge-arrive 620ms cubic-bezier(0.2, 0.8, 0.25, 1) both;
}

.achievement-showcase-art {
  position: relative;
  animation: showcase-badge-turn 620ms cubic-bezier(0.2, 0.8, 0.25, 1) both;
  animation-delay: inherit;
}

.achievement-showcase-badge {
  position: relative;
  display: block;
}

.achievement-showcase-shadow {
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: 12rpx;
  height: 26rpx;
  border-radius: 50%;
  background: rgba(88, 61, 34, 0.1);
  filter: blur(12rpx);
  pointer-events: none;
}

.achievement-showcase-name {
  margin-top: 10rpx;
  color: var(--color-black-min);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.achievement-showcase-name.material-bronze {
  color: var(--color-achievement-bronze);
}

.achievement-showcase-name.material-silver {
  color: var(--color-achievement-silver);
}

.achievement-showcase-name.material-gold {
  color: var(--color-achievement-gold);
}

@keyframes showcase-badge-arrive {
  from {
    opacity: 0;
    transform: translate(var(--badge-x), calc(var(--badge-y) + 28rpx))
      scale(0.78);
  }
  to {
    opacity: 1;
    transform: translate(var(--badge-x), var(--badge-y)) scale(1);
  }
}

@keyframes showcase-badge-turn {
  from {
    transform: rotate(var(--badge-start-angle));
  }
  to {
    transform: rotate(var(--badge-angle));
  }
}
