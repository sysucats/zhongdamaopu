@import "/pages/public/wxss/button.wxss";
@import "/pages/public/wxss/card.wxss";
@import "/pages/public/wxss/tag.wxss";
.page {
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--color-gray-light);
  box-sizing: border-box;
}
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: var(--color-black-min);
}

.empty-tip {
  font-size: 24rpx;
  color: var(--color-gray-max);
  margin-top: 16rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.cat-name {
  font-size: var(--font-size-section);
  font-weight: 600;
  color: var(--color-black-light);
}

.apply-time {
  font-size: 24rpx;
  color: var(--color-gray-max);
  margin-top: 12rpx;
}

.review-note {
  font-size: var(--font-size-body);
  color: var(--color-black-min);
  background: var(--color-gray-light);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.timeline {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--color-gray-normal);
  padding-top: 24rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--color-gray-normal);
}

.timeline-item:last-child::before {
  display: none;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-gray);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.dot-active {
  background: var(--color-primary);
}

.step-content {
  flex: 1;
}

.step-status {
  font-size: 28rpx;
  color: var(--color-black-light);
  font-weight: 500;
}

.step-note {
  font-size: 24rpx;
  color: var(--color-black-min);
  margin-top: 6rpx;
}

.step-time {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: 6rpx;
}
