@import "/pages/public/wxss/card.wxss";
page {
  background-color: var(--color-gray-light);
}
.page {
  min-height: 100vh;
  box-sizing: border-box;

  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}

/* 顶部概览 */
.hero { margin-bottom: var(--space-lg); }
.hero-title {
  font-size: var(--font-size-section);
  font-weight: 600;
  color: var(--color-black-light);
  line-height: 1.5;
}

.hero-sub {
  font-size: var(--font-size-caption);
  margin-top: var(--space-xs);
  color: var(--color-gray-max);
  line-height: 1.6;
}

.stat-row {
  display: flex;
  align-items: center;
  margin-top: var(--space-lg);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: var(--font-size-stat);
  font-weight: 600;
  color: var(--color-black-light);
  line-height: 1.1;
}

.stat-num.gold {
  color: var(--color-achievement-gold);
}

.stat-label {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: 8rpx;
  line-height: 1.5;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-gray-normal);
}

.progress-bar {
  margin-top: var(--space-lg);
  height: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-gray-normal);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(
    90deg,
    var(--color-primary-dark),
    var(--color-primary)
  );
  transition: width 0.6s ease;
}

.progress-text {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: 14rpx;
  text-align: center;
  line-height: 1.5;
}

/* 成就列表 */
.achv-list {
  padding: 0;
}

.series-title {
  margin: var(--space-md) 0 var(--space-sm);
  font-size: var(--font-size-section);
  font-weight: 600;
  color: var(--color-black-light);
}

.series-title:first-child {
  margin-top: 0;
}

.achv-head {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.achv-head-main {
  flex: 1;
  min-width: 0;
}

.achv-name {
  font-size: var(--font-size-section);
  font-weight: 600;
  color: var(--color-black-light);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.achv-desc {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: 6rpx;
  line-height: 1.5;
}

.achv-cur {
  font-size: 22rpx;
  color: var(--color-gray-max);
  background: var(--color-gray-light);
  border-radius: var(--radius-pill);
  padding: 7rpx 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  font-weight: 400;
}

.achv-cur.material-bronze {
  color: #fff;
  background: var(--grad-achievement-bronze);
}

.achv-cur.material-silver {
  color: var(--color-black-light);
  background: var(--grad-achievement-silver);
}

.achv-cur.material-gold {
  color: var(--color-black-light);
  background: var(--grad-achievement-gold);
}

/* 三档奖牌 */
.tier-row {
  display: flex;
  justify-content: space-between;
}

.tier-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.333%;
  min-width: 0;
}

.medal {
  position: relative;
  z-index: 1;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.medal-image {
  width: 100%;
  height: 100%;
}

.tier-cell.locked .medal-image {
  filter: grayscale(1);
  opacity: 0.35;
}

.tier-name {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 10rpx;
  color: var(--color-black-light);
  font-size: var(--font-size-caption);
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}

.tier-cell.locked .tier-name {
  color: var(--color-gray-max);
}

.tier-threshold {
  font-size: 24rpx;
  color: var(--color-black-min);
  margin-top: 4rpx;
  font-weight: 500;
}

.tier-cell.locked .tier-threshold {
  color: var(--color-gray-max);
}

.tier-time {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: 6rpx;
  text-align: center;
  line-height: 1.5;
}

.tier-time.locked-text {
  color: var(--color-gray-dark);
}

.footer-tip {
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: var(--space-lg);
  padding: 0 var(--space-lg);
  line-height: 1.5;
}
