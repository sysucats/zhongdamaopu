<!--pages/info/myAchievement/myAchievement.wxml-->
<view class="page">
  <!-- 顶部概览 -->
  <view class="hero">
    <view class="hero-title">我的成就</view>
    <view class="hero-sub">多和猫猫互动，点亮更多徽章</view>

    <view class="stat-row">
      <view class="stat-cell">
        <view class="stat-num">{{unlockedCount}}</view>
        <view class="stat-label">已解锁</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <view class="stat-num gold">{{goldCount}}</view>
        <view class="stat-label">最高级</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <view class="stat-num">{{percent}}%</view>
        <view class="stat-label">完成度</view>
      </view>
    </view>

    <view class="progress-bar">
      <view class="progress-inner" style="width: {{totalCount ? (unlockedCount / totalCount * 100) : 0}}%;"></view>
    </view>
    <view class="progress-text">已解锁 {{unlockedCount}} / {{totalCount}} 枚徽章</view>
  </view>

  <!-- 成就列表 -->
  <view class="achv-list">
    <block wx:for="{{list}}" wx:key="id">
    <view class="series-title" wx:if="{{item.showSeries}}">{{item.series}}</view>
    <view class="achv-card content-card">
      <view class="achv-head">
        <view class="achv-head-main">
          <view class="achv-name">{{item.name}}</view>
          <view class="achv-desc">{{item.nextCondition}}</view>
        </view>
        <view class="achv-cur material-{{item.currentMaterial}}" wx:if="{{item.currentTier > 0}}">{{item.tiers[item.currentTier - 1].tierName}}</view>
      </view>

      <view class="tier-row">
        <view class="tier-cell {{t.unlocked ? 'unlocked' : 'locked'}}" wx:for="{{item.tiers}}" wx:for-item="t" wx:key="key" bindtap="openBadge" data-key="{{t.key}}">
          <view class="medal">
            <image class="medal-image" src="{{t.frontImage}}" mode="aspectFit" />
          </view>
          <view class="tier-name">{{t.tierName}}</view>
          <view class="tier-threshold">{{t.threshold}}{{item.unit}}</view>
          <view class="tier-time" wx:if="{{t.unlocked}}">{{t.unlock_time_text}}</view>
          <view class="tier-time locked-text" wx:else>{{t.currentCount !== null && t.currentCount >= t.threshold ? '已达条件' : '未解锁'}}</view>
        </view>
      </view>
    </view>
    </block>
  </view>

  <view class="footer-tip">多和猫猫互动，就能解锁更高级别的成就哦~</view>
</view>

<popup id="achievement-detail-popup" style="--popup-background: var(--color-surface);" show="{{showBadgeDetail}}" position="center" bind:close="closeBadge">
  <achievementDetail id="achievement-detail" wx:if="{{selectedBadge}}" achievement="{{selectedBadge}}" bind:close="closeBadge" />
</popup>

<achievement-unlock id="achievement-unlock" />
