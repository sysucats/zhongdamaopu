@import "/pages/public/wxss/card.wxss";
@import "/pages/public/wxss/button.wxss";

page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  background-color: var(--color-gray-light);
}

/* 头像名字和角色 */
.profile-card {
  overflow: hidden;
  padding: 0;
}

.user-container {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
}

.avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.userName-container {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  margin-left: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: calc(50% + 8rpx);
  background-color: var(--color-gray-light);
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx var(--color-ltblack-transparent);
  flex-shrink: 0;
}

.badge {
  margin-top: 10rpx;
  text-overflow: ellipsis;
  width: fit-content;
  white-space: nowrap;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-tag);
  line-height: 1.5;
}
.pro-badge {
  background-color: var(--color-status-pending-bg);
  color: var(--color-status-pending-text);
}
.manager-badge {
  background-color: var(--color-primary-light);
  color: var(--color-primary-text);
}
.visitor-badge {
  background-color: var(--color-gray-normal);
  color: var(--color-black-min);
}

.user-name {
  height: fit-content;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-size-page);
  font-weight: 600;
  color: var(--color-black-light);
}

/* 用户数据 */
.num-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 var(--space-lg);
  padding: var(--space-md) 0 var(--space-lg);
  border-top: 1rpx solid var(--color-gray-normal);
}

.num {
  display: flex;
  flex: 1; /* 平分宽度 */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: auto;
  box-sizing: border-box;
  position: relative;
}

