page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 30rpx;
  background-color: var(--color-gray-light);
}

/* 头像名字和角色 */
.profile-card {
  overflow: hidden;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx var(--color-ltblack-transparent);
}

.user-container {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 24rpx;
}

.avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.userName-container {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  margin-left: 20rpx;
}

.edit-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  padding-left: 12rpx;
  flex-shrink: 0;
}

.edit-container .icon-edit {
  height: 60rpx;
  width: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 20rpx;
  background-color: var(--color-primary-bg);
  font-size: 40rpx;
  color: var(--color-primary);
  margin: 0 !important;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: calc(50% + 8rpx);
  background-color: var(--color-gray-light);
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx var(--color-ltblack-transparent);
  flex-shrink: 0;
}

.badge {
  margin-top: 10rpx;
  text-overflow: ellipsis;
  width: fit-content;
  white-space: nowrap;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.pro-badge {
  background-color: #ffa601;
  color: #fff;
}
.manager-badge {
  background-color: var(--color-primary-light);
  color: var(--color-primary-text);
}
.visitor-badge {
  background-color: var(--color-gray-normal);
  color: var(--color-black-min);
}

.user-name {
  height: fit-content;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-black-light);
}

/* 用户数据 */
.num-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 30rpx;
  padding: 24rpx 0 30rpx;
  border-top: 1rpx solid var(--color-gray-normal);
}

.num {
  display: flex;
  flex: 1; /* 平分宽度 */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: auto;
  box-sizing: border-box;
  position: relative;
}

