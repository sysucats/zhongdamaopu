  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  height: 60%;
  width: 1rpx;
  background-color: var(--color-gray);
} */

.num-title {
  font-size: var(--font-size-stat);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}
.small-title {
  font-size: var(--font-size-caption);
  font-weight: 400;
  line-height: 1.5;
  color: var(--color-gray-max);
}

.content {
  width: 100%;
  box-sizing: border-box;
}

.footprint-home {
  display: block;
  width: 100%;
  margin-bottom: var(--space-md);
}

/* 一些菜单 */
.menu-container {
  width: 100%;

  overflow: hidden;
  padding: 0;

}
.type-separator {
  height: 1rpx;
  background-color: var(--color-gray-normal);
  width: 80%;
  margin: 15rpx 10%;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-lg);
  position: relative;
  min-height: 88rpx;
  box-sizing: border-box;
  gap: var(--space-sm);
}
.icon-and-text {
  display: flex;
  align-items: center;
}
.iconfont {
  font-size: 40rpx;
  margin: 0 var(--space-md) 0 0;
  color: var(--color-black-min);
}
.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  margin: 0 var(--space-md) 0 0;
}
.label-small {
  font-size: var(--font-size-body);
  flex: 1;
}
.right-arrow image {
  margin-right: 40rpx;
  height: 30rpx;
  width: 30rpx;
  margin-top: 15rpx;
  filter: invert(100%);
}
/* 成就展示位 */
.showcase {
  width: 100%;
  box-sizing: border-box;
  margin: var(--space-lg) 0;
}

.showcase-title {
  font-size: var(--font-size-section);
  font-weight: 600;
  color: var(--color-black-light);
}

.showcase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52rpx;
  margin-bottom: var(--space-md);
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.showcase-actions {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}
.showcase-actions .with-icon .iconfont,
.showcase-add .iconfont { margin: 0; }

.showcase-edit,
.showcase-all {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  line-height: 64rpx;
}

.showcase-row {
  display: flex;
  justify-content: flex-start;
}

.showcase-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.333%;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 6rpx;
}

.showcase-medal {
  width: 160rpx;
  height: 160rpx;
}

.showcase-medal.small {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.showcase-name {
  font-size: 24rpx;
  color: var(--color-black-min);
  margin-top: 10rpx;
  text-align: center;
  width: 100%;
  line-height: 34rpx;
  overflow-wrap: break-word;
}

.showcase-time {
  margin-top: 4rpx;
  color: var(--color-gray-max);
  font-size: var(--font-size-caption);
  text-align: center;
  line-height: 1.5;
}

.showcase-empty {
  font-size: 24rpx;
  color: var(--color-gray-max);
  text-align: center;
  padding: 18rpx 0;
}

.showcase-add {
  margin: var(--space-sm) auto 0;
}

/* 成就选择器 */
.achv-picker {
  width: 620rpx;
  max-height: 70vh;
  box-sizing: border-box;
  background: #fff;
  border-radius: var(--radius-modal);
  padding: 0 30rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.achv-picker-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 18rpx 0;
}

.achv-picker-tip {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  line-height: 1.5;
}

.achv-picker-list {
  max-height: 44vh;
}

.achv-pick-item {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: var(--color-gray-light);
  margin-bottom: 12rpx;
}

.achv-pick-item.selected {
  border-color: var(--color-primary-light);
  background: var(--color-primary-bg);
}

.achv-pick-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.achv-pick-name {
  font-size: var(--font-size-body);
  color: var(--color-black-light);
  font-weight: 500;
}

.achv-pick-desc {
  font-size: var(--font-size-caption);
  color: var(--color-gray-max);
  margin-top: 4rpx;
  line-height: 1.5;
}

.achv-pick-check {
  width: 44rpx;
  font-size: 34rpx;
  color: var(--color-primary-text);
  text-align: center;
}

.menu-item:active { background: var(--color-gray-light); }
.right-arrow .iconfont { margin: 0; font-size: 28rpx; color: var(--color-gray-max); }
