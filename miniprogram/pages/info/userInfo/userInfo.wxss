.num-title {
  font-size: 35rpx;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
}
.small-title {
  font-size: 20rpx;
  font-weight: 300;
}

.content {
  width: 100%;
  padding: 0 0 100rpx 0;
}

/* 一些菜单 */
.menu-container {
  width: 100%;
  background-color: white;
  border-radius: 30rpx;
  overflow: hidden;
  padding: 30rpx 0;
  margin-top: -50rpx;
  box-shadow: 0rpx 10rpx 25rpx var(--color-ltblack-transparent);
}
.type-separator {
  height: 1rpx;
  background-color: var(--color-gray-normal);
  width: 80%;
  margin: 15rpx 10%;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx;
  position: relative;
}
.hiddenbtn {
  opacity:0;
	position: absolute;
	top: 10rpx;
	right: 10rpx;
}
.icon-and-text {
  display: flex;
  align-items: center;
}
.iconfont {
  font-size: 60rpx;
  margin: 0 30rpx 0  40rpx;
}
.menu-icon-img {
  width: 46rpx;
  height: 46rpx;
  padding: 18rpx 0;
  margin: 0 37rpx 0 47rpx;
}
.label-small {
  font-size: 28rpx;
  flex: 1;
}
.right-arrow image {
  margin-right: 40rpx;
  height: 30rpx;
  width: 30rpx;
  margin-top: 15rpx;
  filter: invert(100%);
}
/* 成就展示位 */
.showcase {
  width: 100%;
  box-sizing: border-box;
  margin: -60rpx 0 80rpx 0;
  background: #fffdf6;
  border: 2rpx solid #f0e2b8;
  border-radius: 20rpx;
  padding: 24rpx;
}

.showcase-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #7a5b12;
  margin-bottom: 16rpx;
}

.showcase-edit {
  font-size: 22rpx;
  color: #b5983f;
  font-weight: normal;
  margin-left: 12rpx;
}

.showcase-row {
  display: flex;
  justify-content: space-around;
}

.showcase-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33%;
}

.showcase-medal {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  box-shadow: inset 0 -6rpx 10rpx rgba(0, 0, 0, 0.15), 0 4rpx 10rpx rgba(230, 168, 35, 0.3);
}

.showcase-medal.small {
  width: 60rpx;
  height: 60rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.showcase-name {
  font-size: 22rpx;
  color: #8a6d1f;
  margin-top: 10rpx;
  text-align: center;
  white-space: nowrap;
}

.showcase-empty {
  font-size: 24rpx;
  color: #c9b636;
  text-align: center;
  padding: 20rpx 0;
}

/* 成就选择器 */
.achv-picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.achv-picker {
  width: 620rpx;
  max-height: 70vh;
  background: #fffdf6;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

.achv-picker-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #7a5b12;
  text-align: center;
  margin-bottom: 20rpx;
}

.achv-picker-list {
  max-height: 50vh;
}

.achv-pick-item {
  display: flex;
  align-items: center;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.achv-pick-item.selected {
  border-color: #e6a823;
  background: #fdf6e0;
}

.achv-pick-info {
  flex: 1;
  margin-left: 18rpx;
}

.achv-pick-name {
  font-size: 28rpx;
  color: #6b4f0e;
  font-weight: bold;
}

.achv-pick-desc {
  font-size: 22rpx;
  color: #b5983f;
  margin-top: 4rpx;
}

.achv-pick-check {
  width: 44rpx;
  font-size: 34rpx;
  color: #e6a823;
  text-align: center;
}

.achv-picker-btns {
  display: flex;
  margin-top: 24rpx;
}

.achv-picker-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.achv-picker-btn.cancel {
  color: #999;
  background: #f2f2f2;
  margin-right: 20rpx;
}

.achv-picker-btn.confirm {
  color: #fff;
  background: linear-gradient(90deg, #d9ac2b, #e6a823);
}
