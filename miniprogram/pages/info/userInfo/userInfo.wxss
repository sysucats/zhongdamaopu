.num-title {
  font-size: 35rpx;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
}
.small-title {
  font-size: 20rpx;
  font-weight: 300;
}

.content {
  width: 100%;
  box-sizing: border-box;
}

/* 一些菜单 */
.menu-container {
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  padding: 10rpx 0;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx var(--color-ltblack-transparent);
}
.type-separator {
  height: 1rpx;
  background-color: var(--color-gray-normal);
  width: 80%;
  margin: 15rpx 10%;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx;
  position: relative;
}
.hiddenbtn {
  opacity:0;
	position: absolute;
	top: 10rpx;
	right: 10rpx;
}
.icon-and-text {
  display: flex;
  align-items: center;
}
.iconfont {
  font-size: 60rpx;
  margin: 0 30rpx 0  40rpx;
}
.menu-icon-img {
  width: 46rpx;
  height: 46rpx;
  padding: 18rpx 0;
  margin: 0 37rpx 0 47rpx;
}
.label-small {
  font-size: 28rpx;
  flex: 1;
}
.right-arrow image {
  margin-right: 40rpx;
  height: 30rpx;
  width: 30rpx;
  margin-top: 15rpx;
  filter: invert(100%);
}
/* 成就展示位 */
.showcase {
  width: 100%;
  box-sizing: border-box;
  margin: 30rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx var(--color-ltblack-transparent);
}

.showcase-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-black-light);
}

.showcase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.showcase-edit {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 12rpx 0 12rpx 20rpx;
}

.showcase-row {
  display: flex;
  justify-content: flex-start;
}

.showcase-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.333%;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 6rpx;
}

.showcase-medal {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
}

.showcase-medal.tier-1 {
  background: var(--grad-achievement-bronze);
  box-shadow: 0 4rpx 12rpx rgba(176, 111, 50, 0.3);
}

.showcase-medal.tier-2 {
  background: var(--grad-achievement-silver);
  box-shadow: 0 4rpx 12rpx rgba(135, 149, 164, 0.3);
  color: var(--color-black-light);
}

.showcase-medal.tier-3 {
  background: var(--grad-achievement-gold);
  box-shadow: 0 4rpx 12rpx rgba(222, 159, 18, 0.35);
  color: var(--color-black-light);
}

.showcase-medal.small {
  width: 60rpx;
  height: 60rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.showcase-name {
  font-size: 24rpx;
  color: var(--color-black-min);
  margin-top: 10rpx;
  text-align: center;
  width: 100%;
  line-height: 34rpx;
  overflow-wrap: break-word;
}

.showcase-empty {
  font-size: 24rpx;
  color: var(--color-gray-max);
  text-align: center;
  padding: 18rpx 0;
}

.showcase-add {
  color: var(--color-primary);
  margin-top: 12rpx;
  padding: 8rpx;
}

.showcase-all {
  color: var(--color-primary-text);
  font-size: 24rpx;
  text-align: right;
  margin-top: 24rpx;
  padding: 18rpx 0 4rpx;
  border-top: 1rpx solid var(--color-gray-normal);
}

/* 成就选择器 */
.achv-picker {
  width: 620rpx;
  max-height: 70vh;
  box-sizing: border-box;
  background: #fff;
  border-radius: 40rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

.achv-picker-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-black-light);
  text-align: center;
}

.achv-picker-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 18rpx 0;
}

.achv-picker-tip {
  font-size: 22rpx;
  color: var(--color-gray-max);
}

.achv-picker-clear {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 6rpx 0 6rpx 16rpx;
}

.achv-picker-list {
  max-height: 44vh;
}

.achv-pick-item {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: var(--color-gray-light);
  margin-bottom: 12rpx;
}

.achv-pick-item.selected {
  border-color: var(--color-primary-light);
  background: var(--color-primary-bg);
}

.achv-pick-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.achv-pick-name {
  font-size: 28rpx;
  color: var(--color-black-light);
  font-weight: bold;
}

.achv-pick-desc {
  font-size: 22rpx;
  color: var(--color-gray-max);
  margin-top: 4rpx;
}

.achv-pick-check {
  width: 44rpx;
  font-size: 34rpx;
  color: var(--color-primary);
  text-align: center;
}

.achv-picker-btns {
  display: flex;
  margin-top: 24rpx;
}

.achv-picker-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.achv-picker-btn.cancel {
  color: var(--color-black-min);
  background: var(--color-gray-normal);
  margin-right: 20rpx;
}

.achv-picker-btn.confirm {
  color: var(--color-text-onPrimary);
  background: var(--color-primary);
}

.achv-detail {
  position: relative;
  width: 620rpx;
  box-sizing: border-box;
  padding: 40rpx 30rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.achv-detail-close {
  position: absolute;
  top: 12rpx;
  right: 18rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-gray-max);
  font-size: 40rpx;
}

.achv-detail-medal {
  width: 112rpx;
  height: 112rpx;
  font-size: 56rpx;
}

.achv-detail-name {
  margin-top: 24rpx;
  color: var(--color-black-light);
  font-size: 32rpx;
  font-weight: bold;
}

.achv-detail-desc {
  margin-top: 14rpx;
  color: var(--color-gray-max);
  font-size: 26rpx;
  text-align: center;
}

.achv-detail-action {
  margin-top: 32rpx;
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding: 18rpx;
  text-align: center;
  color: var(--color-text-onPrimary);
  background: var(--color-primary);
  font-size: 28rpx;
}
