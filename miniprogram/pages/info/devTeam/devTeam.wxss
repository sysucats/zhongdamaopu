@import "/pages/public/wxss/card.wxss";

page { background: var(--color-gray-light); }
.source-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  width: 100%;
  min-height: 88rpx;
  min-height: max(88rpx, 44px);
  margin: var(--space-sm) 0 0;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: 1.75;
}
.source-row::after { border: none; }
.source-row:active { opacity: 0.65; }
.source-link {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-primary-text);
}
.source-copy {
  flex-shrink: 0;
  color: var(--color-primary-text);
  font-size: 32rpx;
}
