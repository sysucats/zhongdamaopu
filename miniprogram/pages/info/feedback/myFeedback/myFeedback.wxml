<view class="content-page">
  <view class="content-card">
    <view class="content-title">我的反馈</view>
    <view class="content-note">已提交 {{total}} 条反馈，点击猫猫名称可查看详情。</view>
  </view>
  <view class="content-card" wx:for="{{feedbacks}}" wx:key="_id">
    <view class="message-heading">
      <view class="message-title" wx:if="{{item.cat}}" bindtap="toCatDetail" data-cat_id="{{item.cat_id}}">{{item.cat.name}}{{item.cat.campus ? '（' + item.cat.campus + '）' : ''}}</view>
      <view class="message-title" wx:else>信息反馈</view>
      <text class="content-note">{{item.replied ? '已回复' : !item.repliable ? '未订阅通知' : '待回复'}}</text>
    </view>
    <view class="message-meta content-note"><text>我</text><text>{{item.openDateStr}}</text></view>
    <view class="message-bubble user"><text selectable="{{true}}">{{item.feedbackInfo}}</text></view>
    <view class="message-contact content-note" wx:if="{{item.contactInfo}}"><text selectable="{{true}}">联系方式：{{item.contactInfo}}</text></view>
    <block wx:if="{{item.replied}}">
      <view class="message-meta admin content-note"><text>管理员回复</text><text>{{item.replyDateStr}}</text></view>
      <view class="message-bubble admin"><text selectable="{{true}}">{{item.replyInfo}}</text></view>
    </block>
    <view class="message-notice content-note" wx:elif="{{!item.repliable}}">你未订阅回复通知，管理员暂时无法回复。</view>
  </view>
</view>
