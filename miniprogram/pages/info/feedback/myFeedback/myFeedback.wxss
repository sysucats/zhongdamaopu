@import "/pages/public/wxss/card.wxss";

page { background: var(--color-gray-light); }
.message-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-md); }
.message-title { min-width: 0; color: var(--color-black-light); font-size: var(--font-size-section); font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.message-meta { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: var(--space-xs) var(--space-sm); }
.message-meta.admin { justify-content: flex-start; margin-top: var(--space-lg); }
.message-bubble { position: relative; width: fit-content; max-width: 90%; box-sizing: border-box; margin-top: var(--space-xs); padding: 12rpx 20rpx; border-radius: var(--radius-md); color: var(--color-black-light); font-size: var(--font-size-body); font-weight: 400; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
.message-bubble.user { margin-left: auto; background: var(--color-gray-normal); }
.message-bubble.admin { background: var(--color-primary); color: var(--color-text-onPrimary); }
.message-bubble::after { content: ""; position: absolute; top: 18rpx; width: 0; height: 0; border-top: 8rpx solid transparent; border-bottom: 8rpx solid transparent; }
.message-bubble.user::after { right: -8rpx; border-left: 8rpx solid var(--color-gray-normal); }
.message-bubble.admin::after { left: -8rpx; border-right: 8rpx solid var(--color-primary); }
.message-contact { margin-top: var(--space-xs); text-align: right; }
.message-notice { margin-top: var(--space-md); }
