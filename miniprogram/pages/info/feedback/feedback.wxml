<view class="feedback-page">
  <view class="feedback-card">
    <view class="card-heading">
      <view class="card-icon"><text class="iconfont icon-chat"></text></view>
      <view class="card-title">{{text_cfg.feedback.feedback_tip_title}}</view>
    </view>
    <view class="card-description">{{text_cfg.feedback.feedback_tip}}</view>
    <view class="feedback-actions">
      <button class="form-button" bindtap="toMyFeedback">我的反馈</button>
      <button class="form-button primary" bindtap="toFeedback">提交反馈</button>
    </view>
  </view>

  <view class="feedback-card">
    <view class="card-heading">
      <view class="card-icon"><text class="iconfont icon-cat"></text></view>
      <view class="card-title">{{text_cfg.feedback.new_cat_tip_title}}</view>
    </view>
    <view class="card-description">{{text_cfg.feedback.new_cat_tip}}</view>
    <button class="form-button" bindtap="toNewCat">查看新猫问卷</button>
  </view>

  <view class="feedback-card">
    <view class="card-heading">
      <view class="card-icon contact-icon"><text class="iconfont icon-mail"></text></view>
      <view class="card-title">{{text_cfg.feedback.contract_tip_title}}</view>
    </view>
    <text class="card-description contact-description" selectable="{{true}}">{{text_cfg.feedback.contract_tip}}</text>
  </view>
</view>
