@import "/pages/public/wxss/button.wxss";
@import "/pages/public/wxss/card.wxss";
@import "/pages/public/wxss/iconfont.wxss";

page {
  background: var(--color-gray-light);
}
.feedback-page {
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg)
    calc(var(--space-lg) + env(safe-area-inset-bottom));
}
.card-heading {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}
.card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-lg);
  background: var(--color-primary-light);
  color: var(--color-primary-text);
}
.card-icon .iconfont {
  font-size: 36rpx;
  line-height: 1;
}
.card-title {
  min-width: 0;
  color: var(--color-black-light);
  font-size: var(--font-size-section);
  font-weight: 600;
  line-height: 1.5;
}
.card-description {
  margin-bottom: var(--space-lg);
  color: var(--color-black-min);
  font-size: var(--font-size-body);
  line-height: 1.75;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.feedback-actions {
  display: flex;
  gap: var(--space-sm);
}
.feedback-actions .form-button {
  flex: 1;
  min-width: 0;
  width: 0;
}
.contact-icon {
  background: var(--color-gray-light);
  color: var(--color-black-min);
}
.contact-description {
  display: block;
  margin-bottom: 0;
}
.feedback-card:last-child {
  margin-bottom: 0;
}
