@import "/pages/public/wxss/card.wxss";
@import "/pages/public/wxss/button.wxss";

page { background: var(--color-gray-light); }
.reward-actions .form-button {
  flex: 1;
  width: 0;
  min-width: 0;
}
.reward-note { margin: calc(0rpx - var(--space-sm)) 0 var(--space-md); }

.month-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-sm);
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: 1.5;
}
.month-toggle::after { border: none; }
.month-toggle:active { opacity: 0.65; }
.month-label {
  color: var(--color-black-light);
  font-size: var(--font-size-section);
  font-weight: 600;
}
.month-disclosure {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}
.month-disclosure .iconfont { font-size: 28rpx; }
.month-disclosure .expanded { transform: rotate(180deg); }
.month-body { margin-top: var(--space-lg); }
.record-paragraph + .record-paragraph { margin-top: var(--space-sm); }
