@import "/pages/public/wxss/button.wxss";
@import "../../public/wxss/cat-list.wxss";

page {
  background-color: var(--color-gray-light);
}

.follow-page {
  box-sizing: border-box;
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}

.follow-count {
  color: var(--color-gray-max);
  font-size: 24rpx;
}

.follow-count-number {
  color: var(--color-black-light);
  font-size: 30rpx;
  font-weight: 600;
}

.follow-list {
  margin-top: var(--space-lg);
}

.follow-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
  margin-left: var(--space-sm);




}

.follow-btn.followed {
  color: var(--color-gray-max);
}

.follow-btn.unfollowed {
  color: var(--color-primary-text);
}
