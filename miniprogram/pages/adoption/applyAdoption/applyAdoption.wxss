@import "/pages/public/wxss/tag.wxss";
@import "/pages/public/wxss/form.wxss";

.cat-card {
  display: flex;
  align-items: center;
}

.cat-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-gray-normal);
}

.cat-info {
  margin-left: 24rpx;
}

.cat-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text-main);
}

.cat-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

/* 历史申请状态卡片 */
.application-status-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.status-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-main);
}









.status-line {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.8;
}

.status-note {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-gray-light);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

.status-tip {
  font-size: 24rpx;
  color: var(--color-primary-text);
  margin-top: 16rpx;
  line-height: 1.6;
}

.form-item + .form-item {
  margin-top: var(--space-lg);
}

.adoption-tip {
  margin: var(--space-md) 8rpx;
}
